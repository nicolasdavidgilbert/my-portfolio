---
import T from '../i18n/T.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Icon from '../ui/Icon.astro';
import StatusDot from '../ui/StatusDot.astro';
import HeroVisual from '../hero/HeroVisual.astro';
import { cvUrl, person } from '../../data/site';
import { getSocialLink } from '../../data/socialLinks';

const github = getSocialLink('github');
const linkedin = getSocialLink('linkedin');
---

<section aria-labelledby="hero-title" class="spotlight relative overflow-clip">
  <div class="grid-floor" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-[20%] h-[36rem] w-[50rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-accent)_14%,transparent),transparent)] blur-2xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-10 right-[-10%] h-[40rem] w-[40rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-success)_10%,transparent),transparent)] blur-2xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-page px-gutter pt-8 pb-section sm:px-6 lg:px-8 lg:pb-32">
    <div class="hero-in label flex flex-wrap items-center justify-between gap-3 text-fg-muted" style="--d:0ms">
      {person.available && (
        <span class="inline-flex items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3 py-1 text-fg">
          <StatusDot pulse /> <T k="hero.available" />
        </span>
      )}
      <T k="person.location" />
    </div>

    <div class="mt-12 grid items-center gap-12 lg:mt-16 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-10">
      <div>
        <h1 id="hero-title">
          <span class="hero-in block text-base font-medium text-fg-muted sm:text-lg" style="--d:60ms">
            {person.fullName}
          </span>
          <span class="mt-5 block text-[clamp(2.5rem,4.7vw,4.25rem)] leading-[1] font-semibold tracking-tight">
            <span class="hero-in block text-fg" style="--d:130ms">
              <T k="hero.titleFirst" />
            </span>
            <span class="hero-in my-2 block text-[0.5em] font-normal text-fg-subtle" style="--d:190ms">
              &amp;
            </span>
            <span class="hero-in block" style="--d:250ms">
              <T k="hero.titleSecond" class="text-gradient text-gradient--animated" />
            </span>
          </span>
        </h1>

        <p class="hero-in mt-8 max-w-prose text-lg leading-relaxed text-fg-muted" style="--d:330ms">
          <T k="hero.lead" />
        </p>

        <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d:410ms">
          <ButtonLink href="#projects" variant="primary" class="group">
            <T k="hero.viewProjects" />
            <Icon name="arrow-down" class="size-4 transition-transform duration-300 group-hover:translate-y-0.5" />
          </ButtonLink>
          <ButtonLink href={github.href} icon="github" external>
            {github.label}
          </ButtonLink>
          <ButtonLink href={linkedin.href} variant="text" external class="ml-1">
            {linkedin.label}
          </ButtonLink>
          {cvUrl && (
            <ButtonLink href={cvUrl} variant="text" class="ml-1">
              CV
            </ButtonLink>
          )}
        </div>
      </div>

      <div class="hero-in" style="--d:220ms">
        <HeroVisual />
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--d, 0ms);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
      filter: blur(6px);
    }
  }
</style>
