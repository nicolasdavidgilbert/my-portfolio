---
/**
 * Interactive isometric stack: the layers the profile covers, from the Linux
 * base up to the applications. Each layer links to the project that backs it.
 *
 * Interaction (all eased in one rAF loop):
 * - pointer anywhere in the hero steers the tilt; idle sway when untouched
 * - hovering/focusing a layer lights it up while the others move apart to reveal
 *   it, and tells the hero terminal which layer is inspected
 * - dragging (mouse or touch) spins the stack with inertia, then it springs back
 * - a specular highlight follows the cursor across the planes
 */
import T from '../i18n/T.astro';
import { i18nAttrs } from '../../i18n/translate';
import { projectKey } from '../../i18n/project-keys';
import type { TranslationKey } from '../../i18n/types';
import type { ProjectId } from '../../types/project';

const layers = [
  {
    id: 'apps',
    name: 'infra.layers.apps',
    detail: 'React · Next.js · Astro',
    tone: 'accent',
    project: 'cesta-plus-plus',
  },
  {
    id: 'services',
    name: 'infra.layers.services',
    detail: 'Docker · Flask · Node.js',
    tone: 'warm',
    project: 'sistema-llamadas',
  },
  {
    id: 'network',
    name: 'infra.layers.network',
    detail: 'Nginx · LAN · arping',
    tone: 'cool',
    project: 'recordatorios-bot',
  },
  { id: 'linux', name: 'infra.layers.linux', detail: 'Bash · tar · find', tone: 'base', project: 'linux-backup-tui' },
] as const satisfies readonly {
  id: string;
  name: TranslationKey;
  detail: string;
  tone: string;
  project: ProjectId;
}[];
---

<div class="infra-scene" data-infra>
  <nav class="infra-stack" data-infra-stack {...i18nAttrs({ 'aria-label': 'infra.navLabel' })}>
    {layers.map((layer, index) => (
      <a
        href={`#${layer.project}`}
        class:list={['infra-layer', `infra-layer--${layer.tone}`]}
        style={`--i:${layers.length - 1 - index}`}
        data-layer={layer.id}
        data-detail={layer.detail}
        {...i18nAttrs({ 'data-name': layer.name, 'data-project': projectKey(layer.project, 'shortName') })}
        draggable="false"
      >
        <span class="infra-hit" aria-hidden="true"></span>
        <span class="infra-float">
          <span class="infra-plane">
            <span class="infra-shine" aria-hidden="true"></span>
            <span class="infra-scan" aria-hidden="true"></span>
            <span class="infra-dots" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span class="infra-label">
              <strong>
                <T k={layer.name} />
              </strong>
              <small>{layer.detail}</small>
            </span>
            <span class="infra-go" aria-hidden="true">
              → <T k={projectKey(layer.project, 'shortName')} />
            </span>
            <T k="infra.view" vars={{ project: { k: projectKey(layer.project, 'name') } }} class="sr-only" />
          </span>
        </span>
      </a>
    ))}
    <span class="infra-beam" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
  </nav>
  <p class="infra-hint" aria-hidden="true">
    <T k="infra.hint" />
  </p>
</div>

<style>
  .infra-scene {
    --size: min(21rem, 68vw);
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: calc(var(--size) * 1.55);
    padding-top: calc(var(--size) * 0.12);
    perspective: 1400px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Next to the hero text the column narrows; scale the stack with the viewport. */
  @media (min-width: 64rem) {
    .infra-scene {
      --size: min(21rem, 29vw);
    }
  }

  :global(.infra-scene.is-grabbing) {
    cursor: grabbing;
  }

  /* --rx / --rz / --spread / --lx / --ly are eased every frame by the script. */
  .infra-stack {
    --rx: 0deg;
    --rz: 0deg;
    --spread: 0;
    --lx: 50%;
    --ly: 30%;
    position: relative;
    width: var(--size);
    height: var(--size);
    transform-style: preserve-3d;
    transform: rotateX(calc(58deg + var(--rx))) rotateZ(calc(-40deg + var(--rz)));
    cursor: grab;
  }

  /*
   * Per layer, eased by the script:
   * --lift (0..1) highlights the inspected layer, which stays in place;
   * --shift (-1..1) moves the others away from it (above go up, below go down);
   * --dim (0..1) fades the layers that are not being inspected.
   */
  .infra-layer {
    --lift: 0;
    --shift: 0;
    --dim: 0;
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 1.1rem;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--i) * var(--size) * (0.19 + var(--spread) * 0.07)));
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Static hit surface: the visual lifts away, but what you hover stays put (no flicker). */
  .infra-hit {
    position: absolute;
    inset: 0;
    border-radius: 1.1rem;
  }

  .infra-float {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    pointer-events: none;
    translate: 0 0 calc(var(--shift) * var(--size) * 0.13);
  }

  .infra-plane {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--tone) calc(55% + var(--lift) * 45%), transparent);
    background:
      linear-gradient(color-mix(in srgb, var(--tone) 10%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, color-mix(in srgb, var(--tone) 10%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      color-mix(in srgb, var(--tone) calc(9% + var(--lift) * 9%), var(--color-surface));
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.3),
      0 30px 60px -20px color-mix(in srgb, var(--tone) calc(45% + var(--lift) * 40%), transparent),
      inset 0 0 40px color-mix(in srgb, var(--tone) calc(12% + var(--spread) * 8% + var(--lift) * 14%), transparent);
    opacity: calc(1 - var(--dim) * 0.45);
  }

  .infra-layer--accent {
    --tone: var(--color-accent);
  }
  .infra-layer--warm {
    --tone: var(--color-accent-warm);
  }
  .infra-layer--cool {
    --tone: var(--color-info);
  }
  .infra-layer--base {
    --tone: var(--color-success);
  }

  .infra-layer:focus-visible .infra-plane {
    outline: 2px solid var(--tone);
    outline-offset: 4px;
  }

  /* Specular highlight that follows the cursor. */
  .infra-shine {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--lx) var(--ly),
      color-mix(in srgb, var(--tone) 30%, transparent),
      transparent 45%
    );
    opacity: calc(0.35 + var(--lift) * 0.65);
    mix-blend-mode: screen;
  }

  .infra-label {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-mono);
  }

  .infra-label strong {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .infra-label small {
    font-size: 0.66rem;
    color: color-mix(in srgb, var(--tone) 75%, var(--color-fg));
  }

  .infra-go {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--tone);
    opacity: var(--lift);
    transform: translateX(calc((1 - var(--lift)) * -10px));
  }

  .infra-dots {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    display: flex;
    gap: 0.35rem;
  }

  .infra-dots i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--tone);
    opacity: 0.35;
  }

  .infra-dots i:first-child {
    opacity: 1;
    box-shadow: 0 0 10px var(--tone);
  }

  .infra-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tone) 22%, transparent), transparent);
    transform: translateX(-100%);
  }

  /* Vertical beam through the stack, with packets travelling along it. */
  .infra-beam {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: calc(var(--size) * (0.59 + var(--spread) * 0.21));
    background: linear-gradient(to top, transparent, var(--color-accent), transparent);
    transform-origin: 50% 0;
    transform: rotateX(-90deg);
    opacity: calc(0.5 + var(--spread) * 0.5);
    filter: drop-shadow(0 0 6px var(--color-accent));
    pointer-events: none;
  }

  .infra-beam i {
    position: absolute;
    left: -2px;
    top: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 10px var(--color-accent);
    opacity: 0;
  }

  .infra-hint {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    white-space: nowrap;
    color: var(--color-fg-subtle);
    opacity: 0.8;
    transition: opacity 0.6s;
    pointer-events: none;
  }

  :global(.infra-scene.has-interacted) .infra-hint {
    opacity: 0;
  }

  @media (pointer: coarse) {
    .infra-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .infra-float {
      animation: layer-float 7s ease-in-out infinite;
      animation-delay: calc(var(--i) * -0.9s);
    }

    .infra-scan {
      animation: scan 5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: calc(var(--i) * 0.8s);
    }

    .infra-beam i {
      animation: beam-packet 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .infra-beam i:nth-child(2) {
      animation-delay: 0.8s;
      animation-direction: reverse;
    }

    .infra-beam i:nth-child(3) {
      animation-delay: 1.6s;
    }
  }

  @keyframes layer-float {
    50% {
      transform: translateZ(9px);
    }
  }

  @keyframes beam-packet {
    0% {
      top: 100%;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: 0;
      opacity: 0;
    }
  }
</style>

<script>
  import '../../scripts/infra-stack';
</script>
