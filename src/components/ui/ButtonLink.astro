---
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Variant = 'primary' | 'secondary' | 'text';

interface Props {
  href: string;
  variant?: Variant;
  icon?: IconName;
  /** Opens in a new tab and shows an outbound arrow. */
  external?: boolean;
  /** Downloads the target instead of navigating, saved under this file name. */
  download?: string;
  class?: string;
}

const { href, variant = 'secondary', icon, external = false, download, class: className } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'min-h-11 px-4 rounded-md bg-accent text-accent-contrast hover:bg-accent/90',
  secondary: 'min-h-11 px-4 rounded-md border border-border-strong text-fg hover:border-fg-subtle hover:bg-surface',
  text: 'min-h-11 text-fg-muted underline decoration-border-strong underline-offset-4 hover:text-fg hover:decoration-accent',
};
const Link = external ? ExternalLink : 'a';
---

<Link
  href={href}
  download={download}
  class:list={[
    'inline-flex items-center gap-2 text-sm font-medium transition-colors duration-150',
    variants[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} />}
  <slot />
  {external && <Icon name="arrow-up-right" class="size-3.5 opacity-70" />}
</Link>
