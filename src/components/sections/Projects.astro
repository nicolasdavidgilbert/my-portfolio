---
import Section from '../common/Section.astro';
import ProjectCarousel from '../projects/ProjectCarousel.astro';
import { projects } from '../../data/projects';
---

<Section id="proyectos" index="02" label="Proyectos" title="Proyectos seleccionados">
  <p slot="intro" class="mt-5 text-lg leading-relaxed text-fg-muted">
    Producto web y herramientas de sistemas, todos con código público. Desliza, usa las flechas o elige uno abajo.
  </p>

  <div slot="bleed" data-reveal="zoom">
    <ProjectCarousel projects={projects} />
  </div>
</Section>
