<file path="src/components/Tag.astro">
---
interface Props {
  text: string;
  href?: string;
  icon?: string;
}

const { text, href, icon } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element
  href={href}
  class:list={[
    'chip inline-flex items-center gap-2 border-white/10 bg-slate-900/80 text-slate-100',
    href && 'transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/30 hover:text-white',
  ]}
  target={href ? '_blank' : undefined}
  rel={href ? 'noreferrer' : undefined}
>
  {icon && <span class="grid h-4 w-4 place-items-center text-[11px]">{icon}</span>}
  <span>{text}</span>
</Element>
</file>

<file path="src/styles/global.css">
/* src/styles/global.css */
@import "tailwindcss";

@theme {
  --color-bg: #070c18;
  --color-elev: #0f172a;
  --color-text: #e6f0ff;
  --color-muted: #9fb3d8;
  --color-border: #1e2a4a;
  --color-accent: #3b82f6;
  --color-accent2: #60a5fa;
  --color-accent-warm: #14b8a6;
  --color-accent-warm2: #2dd4bf;
  --color-code: #0c1530;
  --color-ok: #22c55e;
  --color-warn: #f59e0b;
  --color-err: #ef4444;

  --shadow-card: 0 12px 30px rgba(0,0,0,.40);
}

:root {
  color-scheme: dark;
}

html {
  @apply scroll-smooth;
}

body {
  @apply bg-bg text-text leading-7 antialiased;
  background-image:
    linear-gradient(180deg, rgba(2,6,23,.1), rgba(2,6,23,.55)),
    radial-gradient(1100px 600px at 90% -15%, rgba(20,184,166,.10), transparent 60%),
    radial-gradient(900px 500px at -10% 10%, rgba(59,130,246,.12), transparent 55%);
}

a {
  @apply text-accent2 transition-colors duration-200 hover:text-accent;
}

a:focus-visible,
button:focus-visible,
summary:focus-visible {
  @apply outline-2 outline-offset-2 outline-accent-warm;
}

.btn {
  @apply inline-flex items-center gap-2 rounded-xl border border-border px-3 py-2 transition-all duration-300 ease-in-out;
  background-color: #0e1730;
  color: var(--color-text);
}

.btn:hover {
  @apply -translate-y-0.5 border-accent/40 shadow-[0_16px_30px_rgba(15,23,42,0.45)];
  background-color: #0b142a;
}

.btn-primary {
  @apply inline-flex items-center gap-2 rounded-xl px-3 py-2 transition-all duration-300 ease-in-out hover:brightness-105;
  --tw-gradient-from: #2563eb;
  --tw-gradient-to: #1d4ed8 var(--tw-gradient-to-position);
  border-color: #1d4ed8;
  color: var(--color-text);
}

.badge {
  @apply rounded-full border px-3 py-1 text-xs font-mono transition-colors duration-300;
  border-color: #22345f;
  background: #0f1c3a;
  color: #cfe3ff;
}

.chip {
  @apply rounded-full border px-2.5 py-1 text-[11.5px] font-mono transition-all duration-300 ease-in-out;
  border-color: #22345f;
  background: #0f1c3a;
  color: #cfe3ff;
}

.card {
  @apply rounded-2xl border border-border bg-elev p-4 transition-all duration-300 ease-in-out;
  box-shadow: var(--shadow-card);
}

.card:hover {
  @apply -translate-y-0.5 border-accent/30 shadow-[0_18px_36px_rgba(0,0,0,0.32)];
}

.hr {
  @apply my-6 h-px;
  background: linear-gradient(90deg, transparent, #20345f, transparent);
}

.section-divider {
  @apply my-10 h-px;
  background: linear-gradient(90deg, transparent, var(--color-accent-warm), var(--color-accent), transparent);
  opacity: 0.5;
}

@keyframes fade-in-up {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: no-preference) {
  .reveal {
    animation: fade-in-up 0.65s ease-out both;
  }

  .reveal-delay-1 {
    animation-delay: 0.08s;
  }

  .reveal-delay-2 {
    animation-delay: 0.16s;
  }

  .reveal-delay-3 {
    animation-delay: 0.24s;
  }

  .reveal-delay-4 {
    animation-delay: 0.32s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reveal,
  .reveal-delay-1,
  .reveal-delay-2,
  .reveal-delay-3,
  .reveal-delay-4 {
    animation: none;
  }
}
</file>

