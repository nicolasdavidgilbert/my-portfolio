<file path="src/components/CommitCard.astro">
---
import { commitHash } from '../../lib/functions';
import { getIconColor } from '../data/iconColors';

interface DiffLine {
  type: 'add' | 'del' | 'ctx';
  text: string;
}

interface Props {
  date: string;
  title: string;
  chips: string[];
  repo?: string;
  demo?: string;
  diff?: DiffLine[];
}

const { date, title, chips = [], repo, demo, diff = [] } = Astro.props;

const cleanTitle = title.replace(/^[^—–-]+[—–-]\s*/, '');
const prefix = title.split(':', 1)[0]?.trim().toLowerCase();
const commitType = prefix.startsWith('feat')
  ? 'feature'
  : prefix.startsWith('fix')
    ? 'fix'
    : prefix.startsWith('docs')
      ? 'docs'
      : prefix.startsWith('test')
        ? 'test'
        : prefix.startsWith('chore')
          ? 'maintenance'
          : 'project';

const diffText = diff
  .map((line) =>
    line.type === 'add' ? '+ ' + line.text : line.type === 'del' ? '- ' + line.text : '  ' + line.text,
  )
  .join('\n');
---

<article class="card group relative overflow-hidden border-white/10 bg-slate-950/80">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono uppercase tracking-[0.22em] text-muted">
    <span
      class:list={[
        'rounded-full px-2.5 py-1 font-semibold',
        commitType === 'feature' && 'bg-accent-warm/15 text-accent-warm',
        commitType === 'fix' && 'bg-rose-500/15 text-rose-300',
        commitType === 'docs' && 'bg-sky-500/15 text-sky-300',
        commitType === 'test' && 'bg-amber-500/15 text-amber-300',
        commitType === 'maintenance' && 'bg-accent/15 text-accent2',
        commitType === 'project' && 'bg-white/5 text-muted',
      ]}
    >
      {commitType}
    </span>
    <span class="text-white/35">#{commitHash(date + '|' + title)}</span>
    <span class="text-white/25">·</span>
    <time class="text-white/70">{date}</time>
  </div>

  <h3 class="mt-3 text-xl font-semibold leading-snug tracking-tight text-white/92 sm:text-2xl">
    {cleanTitle}
  </h3>

  <div class="mt-4 flex flex-wrap gap-2">
    {chips.map((chip) => {
      const slug = String(chip)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
      const iconPath = '/icons/' + slug + '.svg';

      const chipColor = getIconColor(chip);
      return (
        <span class="group chip relative inline-flex cursor-pointer items-center gap-2 overflow-hidden border-white/10 bg-slate-900/80 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--chip-color)] hover:bg-slate-900" title={chip} style={`--chip-color: ${chipColor}`}>
          <div class="pointer-events-none absolute inset-0 rounded-full bg-[var(--chip-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-30" />
          <span class="relative grid h-5 w-5 place-items-center rounded-full bg-white/5 ring-1 ring-white/10 transition-transform duration-300 group-hover:scale-110">
            <img
              src={iconPath}
              alt={chip}
              class="h-3.5 w-3.5 object-contain"
              loading="lazy"
              onerror="this.style.display='none'; this.parentElement?.classList.add('justify-center')"
            />
          </span>
          <span class="relative transition-colors duration-300 group-hover:text-white">{chip}</span>
        </span>
      );
    })}
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {repo && (
      <a class="btn group relative cursor-pointer overflow-hidden text-xs" href={repo} target="_blank" rel="noreferrer">
        <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
        <span class="relative">Repositorio</span>
      </a>
    )}
    {demo && (
      <a class="btn-primary group relative cursor-pointer overflow-hidden text-xs" href={demo} target="_blank" rel="noreferrer">
        <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
        <span class="relative">Demo</span>
      </a>
    )}

    {diff.length > 0 && (
      <details class="group/diff">
        <summary class="btn group relative cursor-pointer list-none overflow-hidden text-xs [&::-webkit-details-marker]:hidden">
          <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
          <span class="relative">Ver diff</span>
        </summary>
        <div class="mt-3 overflow-hidden rounded-2xl border border-white/10 bg-slate-950/95">
          <div class="border-b border-white/5 bg-slate-900/90 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.24em] text-muted">
            diff · {diff.length} líneas
          </div>
          <pre class="m-0 overflow-x-auto p-4 text-[12px] leading-6 whitespace-pre-wrap text-slate-200">{diffText}</pre>
        </div>
      </details>
    )}
  </div>
</article>
</file>

<file path="src/components/SkillsBoard.astro">
---
import { techColors, categories } from '../data/skills';

const { id } = Astro.props;
---

<section id={id ?? 'skills'} class="scroll-mt-24 py-16 overflow-hidden">
  <div class="mb-12 max-w-2xl reveal pl-4 sm:pl-0">
    <p class="font-mono text-sm uppercase tracking-widest text-accent-warm/80 mb-2">Ecosistema</p>
    <h2 class="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-slate-400 sm:text-4xl">
      Tecnologías en movimiento.
    </h2>
  </div>

  <div class="flex flex-col gap-10 w-full">
    {categories.map((category, index) => {
      const isReverse = index % 2 !== 0;
      
      return (
        // Añadimos la clase 'marquee-parent' para controlarla con el script
        <div class="reveal marquee-parent" style={`reveal-delay-${index + 1}`}>
          <h3 class="text-xs font-semibold tracking-wider text-slate-500 uppercase mb-4 pl-4">
            {category.title}
          </h3>

          <div class="relative w-full flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,white_15%,white_85%,transparent)]">
            
            <div class:list={[
              "marquee-inner flex gap-5 py-2 pr-5 min-w-full shrink-0 items-center justify-around select-none",
              isReverse ? "animate-marquee-reverse" : "animate-marquee"
            ]}>
              {category.items.map((item) => {
                const itemColor = techColors[item.label as keyof typeof techColors] || '#94a3b8';
                const isImg = typeof item.icon === 'string' && /\.(svg|png|webp)$/i.test(item.icon);
                const Element = item.href ? 'a' : 'div';

                return (
                  <Element
                    href={item.href}
                    target={item.href ? "_blank" : undefined}
                    rel={item.href ? "noreferrer" : undefined}
                    class="group relative flex items-center gap-3 rounded-full border border-white/10 bg-slate-900/60 px-5 py-3 backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--tech-color)] hover:bg-slate-900"
                    style={{ '--tech-color': itemColor }}
                  >
                    <div class="absolute inset-0 rounded-full bg-[var(--tech-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
                    
                    <span class="relative flex h-6 w-6 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                      {isImg ? (
                        <img src={item.icon!} alt={item.label} class="h-5 w-5 object-contain" loading="lazy" />
                      ) : (
                        <span class="text-sm font-bold" style={{ color: itemColor }}>{item.icon ?? '•'}</span>
                      )}
                    </span>
                    
                    <span class="relative text-sm font-medium tracking-wide text-slate-200 transition-colors duration-300 group-hover:text-white">
                      {item.label}
                    </span>
                  </Element>
                );
              })}
            </div>

            <div class:list={[
              "marquee-inner flex gap-5 py-2 pr-5 min-w-full shrink-0 items-center justify-around select-none",
              isReverse ? "animate-marquee-reverse" : "animate-marquee"
            ]} aria-hidden="true">
              {category.items.map((item) => {
                const itemColor = techColors[item.label as keyof typeof techColors] || '#94a3b8';
                const isImg = typeof item.icon === 'string' && /\.(svg|png|webp)$/i.test(item.icon);
                const Element = item.href ? 'a' : 'div';

                return (
                  <Element
                    href={item.href}
                    target={item.href ? "_blank" : undefined}
                    rel={item.href ? "noreferrer" : undefined}
                    class="group relative flex items-center gap-3 rounded-full border border-white/10 bg-slate-900/60 px-5 py-3 backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--tech-color)] hover:bg-slate-900"
                    style={{ '--tech-color': itemColor }}
                  >
                    <div class="absolute inset-0 rounded-full bg-[var(--tech-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
                    
                    <span class="relative flex h-6 w-6 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                      {isImg ? (
                        <img src={item.icon!} alt={item.label} class="h-5 w-5 object-contain" loading="lazy" />
                      ) : (
                        <span class="text-sm font-bold" style={{ color: itemColor }}>{item.icon ?? '•'}</span>
                      )}
                    </span>
                    
                    <span class="relative text-sm font-medium tracking-wide text-slate-200 transition-colors duration-300 group-hover:text-white">
                      {item.label}
                    </span>
                  </Element>
                );
              })}
            </div>

          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  const setupMarquees = () => {
    const parents = document.querySelectorAll('.marquee-parent');

    parents.forEach(parent => {
      const inners = parent.querySelectorAll('.marquee-inner');

      parent.addEventListener('mouseenter', () => {
        inners.forEach(inner => {
          // Obtenemos las animaciones web activas del elemento
          inner.getAnimations().forEach(animation => {
            animation.playbackRate = 0.25; // Baja al 25% de la velocidad (Súper fluido)
          });
        });
      });

      parent.addEventListener('mouseleave', () => {
        inners.forEach(inner => {
          inner.getAnimations().forEach(animation => {
            animation.playbackRate = 1; // Vuelve a velocidad normal
          });
        });
      });
    });
  };

  // Se ejecuta al cargar la página
  setupMarquees();
</script>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }

  @keyframes marquee-reverse {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(0%); }
  }

  .animate-marquee {
    animation: marquee 35s linear infinite;
  }

  .animate-marquee-reverse {
    animation: marquee-reverse 35s linear infinite;
  }
</style>
</file>

