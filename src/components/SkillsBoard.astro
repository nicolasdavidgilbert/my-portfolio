---
import { categories } from '../data/skills';
import { getIconColorClass } from '../data/iconColors';

const { id } = Astro.props;
const revealDelayClasses = ['[animation-delay:80ms]', '[animation-delay:160ms]', '[animation-delay:240ms]'];
---

<section id={id ?? 'skills'} class="skills-board relative isolate scroll-mt-24 py-16 before:pointer-events-none before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-[linear-gradient(180deg,var(--section-tone-clear)_0%,var(--section-tone-blue)_10%,var(--section-tone-blue)_90%,var(--section-tone-clear)_100%)]">
  <div class="mb-12 max-w-2xl motion-safe:animate-[fade-in-up_0.65s_ease-out_both] motion-reduce:animate-none pl-4 sm:pl-0">
    <p class="font-mono text-sm uppercase tracking-widest text-accent-warm/80 mb-2">Ecosistema</p>
    <h2 class="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-slate-400 sm:text-4xl">
      Tecnologías en movimiento.
    </h2>
  </div>

  <div class="flex flex-col gap-10 w-full">
    {categories.map((category, index) => {
      const isReverse = index % 2 !== 0;
      
      return (
        <div class:list={["motion-safe:animate-[fade-in-up_0.65s_ease-out_both] motion-reduce:animate-none marquee-parent", revealDelayClasses[index]]}>
          <h3 class="text-xs font-semibold tracking-wider text-slate-500 uppercase mb-4 pl-4">
            {category.title}
          </h3>

          <div class="relative w-full flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,white_15%,white_85%,transparent)]">
            
            <div class:list={[
              "marquee-inner flex gap-5 py-2 pr-5 min-w-full shrink-0 items-center justify-around select-none",
              isReverse ? "motion-safe:animate-[marquee_34s_linear_infinite_reverse] motion-reduce:animate-none" : "motion-safe:animate-[marquee_34s_linear_infinite] motion-reduce:animate-none"
            ]}>
              {category.items.map((item) => {
                const isImg = typeof item.icon === 'string' && /\.(svg|png|webp)$/i.test(item.icon);
                const Element = item.href ? 'a' : 'div';

                return (
                  <Element
                    href={item.href}
                    target={item.href ? "_blank" : undefined}
                    rel={item.href ? "noreferrer" : undefined}
                    class:list={["group relative flex items-center gap-3 rounded-full border border-white/10 bg-slate-900/60 px-5 py-3 backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--item-color)] hover:bg-slate-900", getIconColorClass(item.label)]}
                  >
                    <div class="absolute inset-0 rounded-full bg-[var(--item-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
                    
                    <span class="relative flex h-6 w-6 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                      {isImg ? (
                        <img src={item.icon!} alt={item.label} class="h-5 w-5 object-contain" loading="lazy" />
                      ) : (
                        <span class="text-sm font-bold text-[var(--item-color)]">{item.icon ?? '•'}</span>
                      )}
                    </span>
                    
                    <span class="relative text-sm font-medium tracking-wide text-slate-200 transition-colors duration-300 group-hover:text-white">
                      {item.label}
                    </span>
                  </Element>
                );
              })}
            </div>

            <div class:list={[
              "marquee-inner flex gap-5 py-2 pr-5 min-w-full shrink-0 items-center justify-around select-none",
              isReverse ? "motion-safe:animate-[marquee_34s_linear_infinite_reverse] motion-reduce:animate-none" : "motion-safe:animate-[marquee_34s_linear_infinite] motion-reduce:animate-none"
            ]} aria-hidden="true">
              {category.items.map((item) => {
                const isImg = typeof item.icon === 'string' && /\.(svg|png|webp)$/i.test(item.icon);
                const Element = item.href ? 'a' : 'div';

                return (
                  <Element
                    href={item.href}
                    target={item.href ? "_blank" : undefined}
                    rel={item.href ? "noreferrer" : undefined}
                    class:list={["group relative flex items-center gap-3 rounded-full border border-white/10 bg-slate-900/60 px-5 py-3 backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--item-color)] hover:bg-slate-900", getIconColorClass(item.label)]}
                  >
                    <div class="absolute inset-0 rounded-full bg-[var(--item-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
                    
                    <span class="relative flex h-6 w-6 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                      {isImg ? (
                        <img src={item.icon!} alt={item.label} class="h-5 w-5 object-contain" loading="lazy" />
                      ) : (
                        <span class="text-sm font-bold text-[var(--item-color)]">{item.icon ?? '•'}</span>
                      )}
                    </span>
                    
                    <span class="relative text-sm font-medium tracking-wide text-slate-200 transition-colors duration-300 group-hover:text-white">
                      {item.label}
                    </span>
                  </Element>
                );
              })}
            </div>

          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  const setupMarquees = () => {
    const parents = document.querySelectorAll('.marquee-parent');

    parents.forEach(parent => {
      const inners = parent.querySelectorAll('.marquee-inner');

      parent.addEventListener('mouseenter', () => {
        inners.forEach(inner => {
          inner.getAnimations().forEach(animation => {
            animation.playbackRate = 0.25;
          });
        });
      });

      parent.addEventListener('mouseleave', () => {
        inners.forEach(inner => {
          inner.getAnimations().forEach(animation => {
            animation.playbackRate = 1;
          });
        });
      });
    });
  };
  setupMarquees();
</script>
