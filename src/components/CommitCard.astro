---
import { commitHash } from '../../lib/functions';
import { getIconColorClass } from '../data/iconColors';

interface DiffLine {
  type: 'add' | 'del' | 'ctx';
  text: string;
}

interface Props {
  date: string;
  title: string;
  chips: string[];
  repo?: string;
  demo?: string;
  diff?: DiffLine[];
}

const { date, title, chips = [], repo, demo, diff = [] } = Astro.props;

const cleanTitle = title.replace(/^[^:]+:\s*/, '');
const prefix = title.split(':', 1)[0]?.trim().toLowerCase();
const commitType = prefix.startsWith('feat')
  ? 'feature'
  : prefix.startsWith('fix')
    ? 'fix'
    : prefix.startsWith('docs')
      ? 'docs'
      : prefix.startsWith('test')
        ? 'test'
        : prefix.startsWith('chore')
          ? 'maintenance'
          : 'project';

const diffText = diff
  .map((line) =>
    line.type === 'add' ? '+ ' + line.text : line.type === 'del' ? '- ' + line.text : '  ' + line.text,
  )
  .join('\n');
---

<article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-card transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:border-accent/30 hover:shadow-[0_18px_36px_rgba(0,0,0,0.32)]">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono uppercase tracking-[0.22em] text-muted">
    <span
      class:list={[
        'rounded-full px-2.5 py-1 font-semibold',
        commitType === 'feature' && 'bg-accent-warm/15 text-accent-warm',
        commitType === 'fix' && 'bg-rose-500/15 text-rose-300',
        commitType === 'docs' && 'bg-sky-500/15 text-sky-300',
        commitType === 'test' && 'bg-amber-500/15 text-amber-300',
        commitType === 'maintenance' && 'bg-accent/15 text-accent2',
        commitType === 'project' && 'bg-white/5 text-muted',
      ]}
    >
      {commitType}
    </span>
    <span class="text-white/35">#{commitHash(date + '|' + title)}</span>
    <span class="text-white/25">·</span>
    <time class="text-white/70">{date}</time>
  </div>

  <h3 class="mt-3 text-xl font-semibold leading-snug tracking-tight text-white/92 sm:text-2xl">
    {cleanTitle}
  </h3>

  <div class="mt-4 flex flex-wrap gap-2">
    {chips.map((chip) => {
      const slug = String(chip)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
      const iconPath = '/icons/' + slug + '.svg';
      return (
        <span class:list={["group relative inline-flex cursor-pointer items-center gap-2 overflow-hidden rounded-full border border-white/10 bg-slate-900/80 px-2.5 py-1 font-mono text-[11.5px] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--item-color)] hover:bg-slate-900", getIconColorClass(chip)]} title={chip}>
          <div class="pointer-events-none absolute inset-0 rounded-full bg-[var(--item-color)] opacity-0 blur-xl transition-all duration-500 group-hover:opacity-30" />
          <span class="relative grid h-5 w-5 place-items-center rounded-full bg-white/5 ring-1 ring-white/10 transition-transform duration-300 group-hover:scale-110">
            <img
              src={iconPath}
              alt={chip}
              class="h-3.5 w-3.5 object-contain"
              loading="lazy"
              onerror="this.style.display='none'; this.parentElement?.classList.add('justify-center')"
            />
          </span>
          <span class="relative transition-colors duration-300 group-hover:text-white">{chip}</span>
        </span>
      );
    })}
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {repo && (
      <a class="group relative inline-flex cursor-pointer items-center gap-2 overflow-hidden rounded-xl border border-border bg-[#0e1730] px-3 py-2 text-xs text-text transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:border-accent/40 hover:bg-[#0b142a] hover:shadow-[0_16px_30px_rgba(15,23,42,0.45)]" href={repo} target="_blank" rel="noreferrer">
        <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
        <span class="relative">Repositorio</span>
      </a>
    )}
    {demo && (
      <a class="group relative inline-flex cursor-pointer items-center gap-2 overflow-hidden rounded-xl border border-[#1d4ed8] bg-[#2563eb] px-3 py-2 text-xs text-text transition-all duration-300 ease-in-out hover:brightness-105" href={demo} target="_blank" rel="noreferrer">
        <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
        <span class="relative">Demo</span>
      </a>
    )}

    {diff.length > 0 && (
      <details class="group/diff">
        <summary class="group relative inline-flex cursor-pointer list-none items-center gap-2 overflow-hidden rounded-xl border border-border bg-[#0e1730] px-3 py-2 text-xs text-text transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:border-accent/40 hover:bg-[#0b142a] hover:shadow-[0_16px_30px_rgba(15,23,42,0.45)] [&::-webkit-details-marker]:hidden">
          <div class="pointer-events-none absolute inset-0 rounded-xl bg-accent opacity-0 blur-xl transition-all duration-500 group-hover:opacity-20" />
          <span class="relative">Ver diff</span>
        </summary>
        <div class="mt-3 overflow-hidden rounded-2xl border border-white/10 bg-slate-950/95">
          <div class="border-b border-white/5 bg-slate-900/90 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.24em] text-muted">
            diff · {diff.length} líneas
          </div>
          <pre class="m-0 overflow-x-auto p-4 text-[12px] leading-6 whitespace-pre-wrap text-slate-200">{diffText}</pre>
        </div>
      </details>
    )}
  </div>
</article>
