---
import Section from '../common/Section.astro';
import T from '../i18n/T.astro';
import CoreTechCard from '../stack/CoreTechCard.astro';
import { technologies, techCategories } from '../../data/skills';

const core = technologies.filter((tech) => tech.core);

// Everything else, grouped by area in the order the categories are defined.
const others = techCategories
  .map((category) => ({
    category,
    items: technologies.filter((tech) => !tech.core && tech.category === category),
  }))
  .filter((group) => group.items.length > 0);
---

<Section id="stack" label="nav.stack" title="stack.title">
  <T slot="intro" as="p" k="stack.intro" class="mt-5 text-lg leading-relaxed text-fg-muted" />

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {core.map((tech, index) => (
      <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
        <CoreTechCard tech={tech} />
      </li>
    ))}
  </ul>

  <div class="mt-14" data-reveal>
    <T as="h3" k="stack.alsoWorkWith" class="label text-fg-subtle" />
    <dl class="mt-4 grid border-t border-border md:grid-cols-2 md:gap-x-12">
      {others.map((group) => (
        <div class="grid gap-1 border-b border-border py-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
          <T as="dt" k={`stack.categories.${group.category}`} class="label pt-0.5 text-fg-subtle" />
          <dd class="text-fg">
            <ul class="flex flex-wrap gap-x-2 gap-y-1">
              {group.items.map((item, index) => (
                <li>
                  {item.labelKey ? <T k={item.labelKey} /> : item.label}
                  {index < group.items.length - 1 && (
                    <span class="ml-2 text-fg-subtle" aria-hidden="true">
                      ·
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
