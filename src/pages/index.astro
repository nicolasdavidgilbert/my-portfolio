---
import Layout from '../layouts/Layout.astro';
import RepoHeader from '../components/RepoHeader.astro';
import { commits } from '../data/projects';
import SkillsBoard from '../components/SkillsBoard.astro';
import ContactSection from '../components/ContactSection.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import ProfileStory from '../components/ProfileStory.astro';
import { SITE_DESCRIPTION, SITE_TITLE, portfolioStructuredData } from '../data/seo';

const githubUrl = 'https://github.com/nicolasdavidgilbert';
const portfolioRepoUrl = 'https://github.com/nicolasdavidgilbert/my-portfolio';
const linkedinUrl = 'https://www.linkedin.com/in/gilbertnicolas';
const emailUrl = 'nicolas.david.gilbert@gmail.com';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} structuredData={[portfolioStructuredData]}>
  <div id="top" class="space-y-12 lg:space-y-16">
    <RepoHeader repoUrl={portfolioRepoUrl} linkedinUrl={linkedinUrl} />

    <ProfileStory />

    <ProjectShowcase projects={commits} />

    <SkillsBoard id="skills" />

    <ContactSection repoUrl={githubUrl} {linkedinUrl} {emailUrl} />
  </div>
</Layout>
