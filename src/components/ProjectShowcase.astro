---
import type { Commit } from '../types';
import { commitHash } from '../../lib/functions';
import { getIconColorClass } from '../data/iconColors';

interface Props {
  projects: Commit[];
}

const { projects } = Astro.props as Props;
const cleanTitle = (title: string) => title.replace(/^[^:]+:\s*/, '');
const projectName = (title: string) => cleanTitle(title).split('—')[0]?.trim() ?? cleanTitle(title);
const projectDetail = (title: string) => cleanTitle(title).split('—').slice(1).join('—').trim();
const pad = (value: number) => String(value).padStart(2, '0');
const projectAccentClasses: Record<string, string> = {
  '#60a5fa': '[--project-accent:#60a5fa]',
  '#2dd4bf': '[--project-accent:#2dd4bf]',
  '#f59e0b': '[--project-accent:#f59e0b]',
  '#38bdf8': '[--project-accent:#38bdf8]',
  '#fb7185': '[--project-accent:#fb7185]',
};
const projectAccentClass = (accent: string) => projectAccentClasses[accent] ?? '[--project-accent:#60a5fa]';
---

<section id="proyectos" class="project-showcase relative scroll-mt-24 py-16 lg:py-20" data-project-explorer>
  <header class="project-showcase-heading grid items-end gap-6 border-b border-white/10 pb-7 min-[900px]:grid-cols-[minmax(0,1fr)_13rem] min-[900px]:pb-10 motion-safe:animate-[fade-in-up_0.65s_ease-out_both] motion-reduce:animate-none">
    <div>
      <p class="project-kicker font-mono text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-accent2">Proyectos destacados</p>
      <h2 class="mt-[0.65rem] max-w-[20ch] text-[clamp(2rem,4.5vw,3.35rem)] font-[700] leading-[1.04] tracking-normal text-[rgba(255,255,255,0.94)] max-[520px]:text-[2rem]">Trabajo real, recorrido como una historia.</h2>
    </div>
    <div class="project-heading-aside flex items-center gap-[0.85rem] text-[0.78rem] leading-[1.45] text-muted min-[900px]:justify-self-end max-[520px]:hidden">
      <span class="grid h-9 min-w-9 place-items-center rounded-full border border-accent-warm2/30 font-mono text-[0.62rem] text-accent2">{pad(projects.length)}</span>
      <p>Entregas seleccionadas.</p>
    </div>
  </header>

  <div class="project-progress relative z-[35] h-0.5 w-full overflow-hidden bg-white/[0.06]" aria-hidden="true"><span class="block h-full w-full origin-left bg-accent2 [transform:scaleX(0)] [will-change:transform]" data-project-progress></span></div>

  <div class="project-journey relative min-[900px]:grid min-[900px]:grid-cols-[minmax(0,1.58fr)_minmax(19rem,0.82fr)] min-[900px]:items-stretch min-[900px]:gap-x-[clamp(2rem,5vw,4.5rem)] min-[900px]:gap-y-4">
    <aside class="project-stage hidden min-[900px]:grid min-[900px]:min-h-[min(43rem,calc(100vh-9rem))] min-[900px]:grid-rows-[minmax(0,1fr)_auto] min-[900px]:pt-8" aria-label="Vista del proyecto activo">
      <div class="project-stage-chrome relative grid min-h-0 grid-rows-[3.25rem_minmax(0,1fr)] overflow-hidden rounded-lg border border-white/[0.1] bg-[rgba(8,15,29,0.76)] shadow-[0_1.5rem_3.5rem_rgba(0,0,0,0.24)]">
        <div class="project-stage-topbar relative z-10 grid h-[3.25rem] grid-cols-[1fr_auto_1fr] items-center border-b border-white/[0.08] bg-[#0d1422] px-4 font-mono text-[0.61rem] uppercase text-[rgba(159,179,216,0.72)]">
          <div class="stage-lights flex gap-[0.4rem] [&>span]:h-[0.48rem] [&>span]:w-[0.48rem] [&>span]:rounded-full [&>span]:bg-[#3b4558] [&>span:first-child]:bg-[#fb7185] [&>span:nth-child(2)]:bg-[#fbbf24] [&>span:last-child]:bg-[#34d399]" aria-hidden="true"><span></span><span></span><span></span></div>
          <p><span data-stage-number>{pad(1)}</span> / {pad(projects.length)}</p>
          <span class="stage-status inline-flex items-center justify-self-end gap-[0.45rem]"><i class="h-[0.42rem] w-[0.42rem] rounded-full bg-[#34d399] shadow-[0_0_10px_rgba(52,211,153,0.8)]"></i> live preview</span>
        </div>

        <div class="project-stage-panels relative min-h-0 overflow-hidden bg-[#080d18] bg-[linear-gradient(rgba(255,255,255,0.027)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.027)_1px,transparent_1px)] bg-[size:32px_32px]">
          <div class="project-stage-track grid h-full w-[500%] grid-cols-5 translate-x-0 transition-transform duration-[680ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform data-[active-index=1]:translate-x-[-20%] data-[active-index=2]:translate-x-[-40%] data-[active-index=3]:translate-x-[-60%] data-[active-index=4]:translate-x-[-80%] motion-reduce:transition-none" data-project-track data-active-index="0">
          {projects.map((project, index) => (
            <article
              class:list={["project-stage-panel relative grid h-full min-w-0 place-items-center overflow-hidden p-[clamp(1rem,2vw,1.8rem)] before:absolute before:inset-0 before:border-t-[3px] before:border-[var(--project-accent)] before:opacity-[0.85]", projectAccentClass(project.accent)]}
              data-project-panel
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              {project.visual === 'web' && project.image ? (
                <div class="project-browser w-[min(100%,38rem)] overflow-hidden rounded-lg border border-white/15 bg-[#edf1f6] shadow-[0_1.5rem_4rem_rgba(0,0,0,0.45)] [transform:perspective(1200px)_rotateX(1deg)_rotateY(-1.5deg)] transition-transform duration-700 [.project-stage-panel.is-active_&]:[transform:perspective(1200px)_rotateX(0)_rotateY(0)]">
                  <div class="project-browser-bar grid h-[2.55rem] grid-cols-[4.3rem_1fr_1rem] items-center gap-[0.65rem] bg-[#dfe5ed] px-3 text-[0.58rem] text-[#536174]">
                    <div class="browser-controls flex gap-[0.65rem] text-[0.9rem]" aria-hidden="true"><span>‹</span><span>›</span><span>↻</span></div>
                    <div class="browser-address flex items-center gap-[0.4rem] overflow-hidden whitespace-nowrap rounded border border-[#c7d0dc] bg-[#f7f9fb] px-[0.6rem] py-[0.28rem] text-ellipsis"><span aria-hidden="true">⌁</span>{project.demo?.replace(/^https?:\/\//, '')}</div>
                    <span aria-hidden="true">⋮</span>
                  </div>
                  <div class="project-browser-canvas aspect-[16/10] overflow-hidden">
                    <img class="h-full w-full object-cover object-top" src={project.image} alt={`Captura de ${projectName(project.title)}`} loading={index === 0 ? 'eager' : 'lazy'} />
                  </div>
                </div>
              ) : project.visual === 'terminal' ? (
                <div class="project-terminal w-[min(100%,34rem)] rounded-lg border border-[rgba(245,158,11,0.3)] bg-[#070b12] p-[clamp(1.1rem,3vw,2rem)] font-mono text-[clamp(0.58rem,1.2vw,0.78rem)] leading-[2] text-[#dbe5f4] shadow-[0_1.5rem_4rem_rgba(0,0,0,0.45)] [&_.terminal-line>span]:text-[#34d399] [&_.terminal-line.success]:text-[#34d399] [&_.terminal-line.dim]:text-[#8290a6]" aria-label="Simulación del proceso de backup">
                  <div class="terminal-line dim">$ ./incremental.sh /home /mnt/backups</div>
                  <div class="terminal-line"><span>→</span> Buscando último snapshot...</div>
                  <div class="terminal-line"><span>✓</span> snapshot_2026-03-01.snar</div>
                  <div class="terminal-tree my-4 border-l border-[#f59e0b] bg-[rgba(245,158,11,0.04)] px-4 py-[0.7rem] text-[#abb9ce]">
                    <p>backups/</p><p>├── FULL/2026-03-01.tar.gz</p><p>└── INC/</p>
                    <p>&nbsp;&nbsp;&nbsp;├── 2026-03-02.tar.gz</p><p>&nbsp;&nbsp;&nbsp;└── 2026-03-03.tar.gz</p>
                  </div>
                  <div class="terminal-line success"><span>✓</span> Backup verificado · 1.8 GB</div>
                  <span class="terminal-cursor mt-[0.8rem] inline-block h-[0.9rem] w-[0.5rem] bg-[#f59e0b] motion-safe:animate-[cursor-blink_1s_steps(1)_infinite]" aria-hidden="true"></span>
                </div>
              ) : project.visual === 'network' ? (
                <div class="network-visual relative grid w-[min(100%,34rem)] grid-cols-[1fr_2.5rem_1fr_2.5rem_1fr] items-center" aria-label="Flujo de detección y recordatorios">
                  <div class="network-node node-router relative z-[2] grid min-h-[8.2rem] min-w-0 content-center rounded-lg border border-[rgba(56,189,248,0.28)] bg-[#0b1422] p-4 text-center [&>span]:font-mono [&>span]:text-[0.6rem] [&>span]:text-[#38bdf8] [&>strong]:mt-2 [&>strong]:text-[clamp(0.65rem,1.1vw,0.82rem)] [&>strong]:text-white [&>small]:mt-1 [&>small]:text-[clamp(0.48rem,0.8vw,0.62rem)] [&>small]:text-[#8193ad]"><span>01</span><strong>Red local</strong><small>arping activo</small></div>
                  <div class="network-path path-one relative h-px overflow-hidden bg-[rgba(56,189,248,0.3)] [&>i]:absolute [&>i]:-top-0.5 [&>i]:h-[5px] [&>i]:w-[5px] [&>i]:rounded-full [&>i]:bg-[#38bdf8] [&>i]:motion-safe:animate-[data-flow_1.8s_linear_infinite]"><i></i></div>
                  <div class="network-node node-engine relative z-[2] grid min-h-[8.2rem] min-w-0 content-center rounded-lg border border-[rgba(56,189,248,0.28)] bg-[#0b1422] p-4 text-center [&>span]:font-mono [&>span]:text-[0.6rem] [&>span]:text-[#38bdf8] [&>strong]:mt-2 [&>strong]:text-[clamp(0.65rem,1.1vw,0.82rem)] [&>strong]:text-white [&>small]:mt-1 [&>small]:text-[clamp(0.48rem,0.8vw,0.62rem)] [&>small]:text-[#8193ad]"><span>02</span><strong>Python</strong><small>presencia detectada</small></div>
                  <div class="network-path path-two relative h-px overflow-hidden bg-[rgba(56,189,248,0.3)] [&>i]:absolute [&>i]:-top-0.5 [&>i]:h-[5px] [&>i]:w-[5px] [&>i]:rounded-full [&>i]:bg-[#38bdf8] [&>i]:[animation-delay:0.9s] [&>i]:motion-safe:animate-[data-flow_1.8s_linear_infinite]"><i></i></div>
                  <div class="network-node node-message relative z-[2] grid min-h-[8.2rem] min-w-0 content-center rounded-lg border border-[rgba(56,189,248,0.28)] bg-[#0b1422] p-4 text-center [&>span]:font-mono [&>span]:text-[0.6rem] [&>span]:text-[#38bdf8] [&>strong]:mt-2 [&>strong]:text-[clamp(0.65rem,1.1vw,0.82rem)] [&>strong]:text-white [&>small]:mt-1 [&>small]:text-[clamp(0.48rem,0.8vw,0.62rem)] [&>small]:text-[#8193ad]"><span>03</span><strong>Telegram</strong><small>recordatorio enviado</small></div>
                  <div class="network-pulse pulse-one absolute left-[4%] z-[1] h-20 w-20 rounded-full border border-[rgba(56,189,248,0.18)] motion-safe:animate-[network-pulse_2.6s_ease-out_infinite]"></div><div class="network-pulse pulse-two absolute right-[4%] z-[1] h-20 w-20 rounded-full border border-[rgba(56,189,248,0.18)] [animation-delay:1.3s] motion-safe:animate-[network-pulse_2.6s_ease-out_infinite]"></div>
                </div>
              ) : (
                <div class="system-visual grid w-[min(100%,35rem)] grid-cols-[0.8fr_3rem_1.2fr] items-center" aria-label="Arquitectura del sistema de llamadas">
                  <div class="system-call grid justify-items-center rounded-lg border border-[rgba(251,113,133,0.35)] bg-[#170d16] px-[0.8rem] py-6 text-center [&>small]:text-[0.55rem] [&>small]:text-[#9f8391] [&>strong]:mt-[0.35rem] [&>strong]:text-[0.82rem] [&>strong]:text-white [&>time]:mt-[0.6rem] [&>time]:font-mono [&>time]:text-[#fb7185]">
                    <span class="call-beacon mb-3 h-[0.8rem] w-[0.8rem] rounded-full bg-[#fb7185] shadow-[0_0_0_0.4rem_rgba(251,113,133,0.12)] motion-safe:animate-[call-pulse_1.3s_ease-in-out_infinite]"></span><small>HABITACIÓN 204</small><strong>Llamada activa</strong><time>00:18</time>
                  </div>
                  <div class="system-flow-line h-px bg-[rgba(251,113,133,0.35)]"></div>
                  <div class="system-services grid grid-cols-2 gap-[0.55rem] [&>div]:grid [&>div]:min-w-0 [&>div]:rounded-[5px] [&>div]:border [&>div]:border-white/[0.09] [&>div]:bg-[#0c1420] [&>div]:p-[0.7rem] [&_span]:font-mono [&_span]:text-[0.5rem] [&_span]:text-[#fb7185] [&_strong]:text-[0.68rem] [&_strong]:text-white [&_small]:overflow-hidden [&_small]:truncate [&_small]:text-[0.52rem] [&_small]:text-[#7f8fa8]">
                    <div><span>01</span><strong>Flask API</strong><small>evento recibido</small></div>
                    <div><span>02</span><strong>MariaDB</strong><small>registro creado</small></div>
                    <div><span>03</span><strong>Pushover</strong><small>equipo avisado</small></div>
                    <div><span>04</span><strong>Relé</strong><small>señal activa</small></div>
                  </div>
                </div>
              )}

              <div class="stage-project-label absolute inset-x-4 bottom-4 z-[4] flex items-center gap-[0.8rem] rounded-md border border-white/[0.12] bg-[rgba(5,9,17,0.9)] px-[0.8rem] py-[0.7rem] shadow-[0_0.8rem_2rem_rgba(0,0,0,0.35)] [&>span]:font-mono [&>span]:text-[0.7rem] [&>span]:text-[var(--project-accent)] [&>div]:grid [&>div]:min-w-0 [&>div]:leading-[1.25] [&_small]:text-[0.52rem] [&_small]:uppercase [&_small]:text-[rgba(159,179,216,0.7)] [&_strong]:overflow-hidden [&_strong]:truncate [&_strong]:text-[0.78rem] [&_strong]:text-white">
                <span>{pad(index + 1)}</span>
                <div><small>Proyecto activo</small><strong>{projectName(project.title)}</strong></div>
              </div>
            </article>
          ))}
          </div>
        </div>
        <button type="button" class="absolute left-3 top-1/2 z-20 grid h-11 w-9 -translate-y-1/2 place-items-center rounded-md border border-white/15 bg-[rgba(5,9,17,0.82)] text-2xl leading-none text-white/80 shadow-[0_0.75rem_2rem_rgba(0,0,0,0.3)] backdrop-blur-md transition-[transform,border-color,background-color,color] duration-200 hover:-translate-y-[calc(50%+2px)] hover:border-accent2/50 hover:bg-[#101827] hover:text-white" data-project-prev aria-label="Proyecto anterior" title="Proyecto anterior">‹</button>
        <button type="button" class="absolute right-3 top-1/2 z-20 grid h-11 w-9 -translate-y-1/2 place-items-center rounded-md border border-white/15 bg-[rgba(5,9,17,0.82)] text-2xl leading-none text-white/80 shadow-[0_0.75rem_2rem_rgba(0,0,0,0.3)] backdrop-blur-md transition-[transform,border-color,background-color,color] duration-200 hover:-translate-y-[calc(50%+2px)] hover:border-accent2/50 hover:bg-[#101827] hover:text-white" data-project-next aria-label="Proyecto siguiente" title="Proyecto siguiente">›</button>
      </div>

      <nav class="project-stage-nav mt-[0.8rem] grid grid-cols-5 gap-[0.45rem]" aria-label="Ir a un proyecto">
        {projects.map((project, index) => (
          <button type="button" class:list={["project-stage-dot relative grid h-[3.1rem] min-w-0 content-center overflow-hidden rounded border border-white/[0.08] bg-[rgba(8,15,29,0.58)] px-[0.55rem] py-[0.35rem] text-left text-[rgba(159,179,216,0.72)] transition-[border-color,background-color,color] duration-[250ms] before:absolute before:inset-x-0 before:bottom-0 before:h-0.5 before:origin-left before:scale-x-0 before:bg-[var(--project-accent)] before:transition-transform before:duration-[350ms] hover:border-[color-mix(in_srgb,var(--project-accent)_45%,transparent)] hover:bg-[#101827] hover:text-white [&.is-active]:border-[color-mix(in_srgb,var(--project-accent)_45%,transparent)] [&.is-active]:bg-[#101827] [&.is-active]:text-white [&.is-active]:before:scale-x-100 [&>span]:font-mono [&>span]:text-[0.58rem] [&>strong]:overflow-hidden [&>strong]:truncate [&>strong]:text-[0.58rem] motion-reduce:before:transition-none", projectAccentClass(project.accent), index === 0 && "is-active"]} data-project-nav={index} aria-label={`Ir a ${projectName(project.title)}`} aria-current={index === 0 ? "true" : undefined}>
            <span>{pad(index + 1)}</span><strong>{projectName(project.title)}</strong>
          </button>
        ))}
      </nav>
    </aside>

    <div class="project-story relative grid min-w-0 overflow-hidden" data-project-story aria-live="polite">
      <div class="pointer-events-none absolute inset-y-[3.5rem] left-0 z-10 w-[7px] min-[900px]:inset-y-16" aria-hidden="true">
        <div class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-white/[0.12]"></div>
        <div class="relative grid h-full grid-rows-5">
          {projects.map(() => <span class="border-b border-white/[0.14] last:border-b-0"></span>)}
        </div>
        <span class="absolute top-0 left-px h-[20%] w-[5px] rounded-[1px] [--marker-accent:#f59e0b] bg-[var(--marker-accent)] shadow-[0_0_18px_color-mix(in_srgb,var(--marker-accent)_72%,transparent)] transition-[transform,background-color,box-shadow] data-[active-index=1]:[--marker-accent:#2dd4bf] data-[active-index=2]:[--marker-accent:#60a5fa] data-[active-index=3]:[--marker-accent:#38bdf8] data-[active-index=4]:[--marker-accent:#fb7185] duration-[680ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform data-[active-index=1]:translate-y-full data-[active-index=2]:translate-y-[200%] data-[active-index=3]:translate-y-[300%] data-[active-index=4]:translate-y-[400%] motion-reduce:transition-none" data-project-story-marker data-active-index="0"></span>
      </div>
      {projects.map((project, index) => (
        <article
          class:list={["project-chapter invisible pointer-events-none relative col-start-1 row-start-1 translate-y-4 opacity-0 border-b border-white/[0.08] py-[3.5rem] pr-0 pl-5 transition-[opacity,transform] duration-[420ms] max-[520px]:pl-4 min-[900px]:flex min-[900px]:flex-col min-[900px]:justify-center min-[900px]:border-b-0 min-[900px]:py-16 min-[900px]:pr-0 min-[900px]:pl-[1.45rem] [&.is-active]:visible [&.is-active]:pointer-events-auto [&.is-active]:translate-y-0 [&.is-active]:opacity-100 motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:transition-none [&.slide-next]:motion-safe:animate-[story-scroll-next_520ms_cubic-bezier(0.22,1,0.36,1)_both] [&.slide-prev]:motion-safe:animate-[story-scroll-prev_520ms_cubic-bezier(0.22,1,0.36,1)_both]", projectAccentClass(project.accent), index === 0 && "is-active"]}
          data-project-step
          data-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <div class="project-mobile-visual relative mb-7 grid aspect-[16/10] w-full place-items-center overflow-hidden rounded-lg border border-white/10 bg-[#090f1e] bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:28px_28px] min-[900px]:hidden after:pointer-events-none after:absolute after:inset-0 after:border-t-2 after:border-[var(--project-accent)]" aria-hidden="true">
            {project.image ? <img class="h-full w-full object-cover object-top" src={project.image} alt="" loading="lazy" /> : <span class="font-mono text-[clamp(3rem,18vw,6rem)] font-bold text-[var(--project-accent)]">{pad(index + 1)}</span>}
          </div>

          <div class="project-meta flex flex-wrap items-center gap-x-[0.8rem] gap-y-[0.55rem] font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[rgba(159,179,216,0.72)] max-[520px]:gap-[0.45rem]">
            <span class="project-index grid h-[2.1rem] w-[2.1rem] place-items-center rounded-full border border-[color-mix(in_srgb,var(--project-accent)_45%,transparent)] font-bold text-[var(--project-accent)]">{pad(index + 1)}</span>
            <span class="project-commit text-white/50 max-[520px]:w-[calc(100%-3rem)]">commit {commitHash(project.date + '|' + project.title)}</span>
            <time class="max-[520px]:ml-12" datetime={project.date}>{project.date}</time>
          </div>

          <h3 class="mt-5 [overflow-wrap:anywhere] text-[clamp(1.85rem,4vw,3rem)] font-bold leading-[1.02] tracking-normal text-[rgba(255,255,255,0.96)] min-[900px]:text-[clamp(2rem,3.5vw,3.35rem)]">{projectName(project.title)}</h3>
          {projectDetail(project.title) && <p class="project-subtitle mt-[0.55rem] font-mono text-[0.72rem] uppercase leading-[1.6] text-[var(--project-accent)]">{projectDetail(project.title)}</p>}
          <p class="project-summary mt-[1.35rem] max-w-[34rem] text-[0.98rem] leading-[1.75] text-[rgba(230,240,255,0.78)]">{project.summary}</p>

          <ul class="project-highlights mt-[1.35rem] grid gap-[0.55rem] text-[0.78rem] leading-[1.5] text-muted">
            {project.highlights.map((highlight) => <li class="relative pl-[1.15rem] before:absolute before:left-0 before:top-[0.55em] before:h-[0.38rem] before:w-[0.38rem] before:rotate-45 before:border before:border-[var(--project-accent)]">{highlight}</li>)}
          </ul>

          <div class="project-tech mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
            {project.chips.map((chip) => {
              const slug = chip.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
              return (
                <span class:list={["inline-flex min-h-8 items-center gap-[0.45rem] rounded border border-white/[0.09] bg-[rgba(8,15,29,0.7)] px-[0.65rem] py-[0.35rem] font-mono text-[0.62rem] text-[rgba(230,240,255,0.82)]", getIconColorClass(chip)]}>
                  <img class="h-[0.95rem] w-[0.95rem] object-contain" src={`/icons/${slug}.svg`} alt="" loading="lazy" />{chip}
                </span>
              );
            })}
          </div>

          <div class="project-actions mt-7 flex flex-wrap gap-[0.7rem]">
            {project.demo && <a class="inline-flex min-h-[2.65rem] items-center justify-center gap-[0.6rem] rounded-md border border-[var(--project-accent)] bg-[var(--project-accent)] px-[0.9rem] py-[0.55rem] text-[0.76rem] font-bold text-[#07101d] transition-[transform,filter] duration-[220ms] hover:-translate-y-0.5 hover:text-[#07101d] hover:brightness-110" href={project.demo} target="_blank" rel="noreferrer">Ver proyecto <span class="external-link-icon" aria-hidden="true"></span></a>}
            {project.repo && (
              <a class="project-repo-link inline-flex min-h-[2.65rem] items-center justify-center gap-[0.6rem] rounded-md border border-white/15 bg-transparent px-[0.9rem] py-[0.55rem] text-[0.76rem] font-bold text-white/85 transition-[transform,filter,border-color,color] duration-[220ms] hover:-translate-y-0.5 hover:border-[var(--project-accent)] hover:text-white hover:brightness-110" href={project.repo} target="_blank" rel="noreferrer">
                <img class="h-4 w-4" src="/icons/github.svg" alt="" /> Repositorio <span class="external-link-icon" aria-hidden="true"></span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <nav class="project-carousel-controls col-span-full min-[900px]:hidden mt-4 flex items-center justify-between gap-4 border-t border-white/[0.08] pt-4" aria-label="Navegación de proyectos">
      <button type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-md border border-white/[0.12] bg-white/[0.035] text-lg text-white/80 transition-[transform,border-color,background-color,color] duration-200 hover:-translate-y-0.5 hover:border-accent2/40 hover:bg-white/[0.07] hover:text-white" data-project-prev aria-label="Proyecto anterior" title="Proyecto anterior">‹</button>
      <div class="flex items-center justify-center gap-2" aria-label="Seleccionar proyecto">
        {projects.map((project, index) => (
          <button type="button" class:list={["h-2 w-2 rounded-full bg-white/20 transition-[width,background-color] duration-300 hover:bg-white/45 [&.is-active]:w-7 [&.is-active]:bg-accent2", index === 0 && "is-active"]} data-project-nav={index} aria-label={`Ir a ${projectName(project.title)}`} aria-current={index === 0 ? "true" : undefined}></button>
        ))}
      </div>
      <button type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-md border border-white/[0.12] bg-white/[0.035] text-lg text-white/80 transition-[transform,border-color,background-color,color] duration-200 hover:-translate-y-0.5 hover:border-accent2/40 hover:bg-white/[0.07] hover:text-white" data-project-next aria-label="Proyecto siguiente" title="Proyecto siguiente">›</button>
    </nav>
  </div>
</section>

<script>
  const initProjectExplorer = () => {
    const explorer = document.querySelector<HTMLElement>("[data-project-explorer]");
    if (!explorer || explorer.dataset.ready === "true") return;
    explorer.dataset.ready = "true";

    const steps = [...explorer.querySelectorAll<HTMLElement>("[data-project-step]")];
    const panels = [...explorer.querySelectorAll<HTMLElement>("[data-project-panel]")];
    const track = explorer.querySelector<HTMLElement>("[data-project-track]");
    const storyMarker = explorer.querySelector<HTMLElement>("[data-project-story-marker]");
    const navButtons = [...explorer.querySelectorAll<HTMLButtonElement>("[data-project-nav]")];
    const prevButtons = [...explorer.querySelectorAll<HTMLButtonElement>("[data-project-prev]")];
    const nextButtons = [...explorer.querySelectorAll<HTMLButtonElement>("[data-project-next]")];
    const number = explorer.querySelector<HTMLElement>("[data-stage-number]");
    const progress = explorer.querySelector<HTMLElement>("[data-project-progress]");
    let activeIndex = -1;

    const setActive = (requestedIndex: number, direction?: "next" | "prev") => {
      if (!steps.length) return;

      const nextIndex = (requestedIndex + steps.length) % steps.length;
      if (nextIndex === activeIndex) return;

      const resolvedDirection =
        direction ?? (activeIndex < 0 || nextIndex > activeIndex ? "next" : "prev");
      activeIndex = nextIndex;

      steps.forEach((step, index) => {
        const isActive = index === nextIndex;
        step.classList.toggle("is-active", isActive);
        step.classList.remove("slide-next", "slide-prev");
        step.setAttribute("aria-hidden", String(!isActive));

        if (isActive) {
          void step.offsetWidth;
          step.classList.add(resolvedDirection === "next" ? "slide-next" : "slide-prev");
        }
      });

      panels.forEach((panel, index) => {
        const isActive = index === nextIndex;
        panel.classList.toggle("is-active", isActive);
        panel.setAttribute("aria-hidden", String(!isActive));
      });

      if (track) track.dataset.activeIndex = String(nextIndex);
      if (storyMarker) storyMarker.dataset.activeIndex = String(nextIndex);

      navButtons.forEach((button) => {
        const isActive = Number(button.dataset.projectNav) === nextIndex;
        button.classList.toggle("is-active", isActive);
        if (isActive) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });

      if (number) number.textContent = String(nextIndex + 1).padStart(2, "0");
      if (progress) progress.style.transform = `scaleX(${(nextIndex + 1) / steps.length})`;
    };

    prevButtons.forEach((button) => {
      button.addEventListener("click", () => setActive(activeIndex - 1, "prev"));
    });

    nextButtons.forEach((button) => {
      button.addEventListener("click", () => setActive(activeIndex + 1, "next"));
    });

    navButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextIndex = Number(button.dataset.projectNav);
        if (!Number.isFinite(nextIndex)) return;
        setActive(nextIndex, nextIndex >= activeIndex ? "next" : "prev");
      });
    });

    explorer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActive(activeIndex - 1, "prev");
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setActive(activeIndex + 1, "next");
      }
    });

    setActive(0, "next");
  };

  initProjectExplorer();
  document.addEventListener("astro:page-load", initProjectExplorer);
</script>
