---
import type { ContactProps } from '../data/contact';
import { getIconColorClass } from '../data/iconColors';
import { iconMap, getContactChannels } from '../data/contact';

const { repoUrl, linkedinUrl, emailUrl } = Astro.props as ContactProps;
const contactChannels = getContactChannels({ repoUrl, linkedinUrl, emailUrl });
const socialChannels = contactChannels.filter((channel) => channel.name !== 'Email');
---

<section id="contacto" class="contact-editorial relative scroll-mt-24 py-16 lg:py-20" aria-labelledby="contact-title">
  <div class="grid gap-5 border-b border-white/[0.09] pb-8 motion-safe:animate-[fade-in-up_0.65s_ease-out_both] motion-reduce:animate-none min-[820px]:grid-cols-[minmax(0,1fr)_22rem] min-[820px]:items-end">
    <div><p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-accent2">Contacto</p><h2 id="contact-title" class="mt-3 max-w-[17ch] text-[clamp(2rem,4.5vw,3.35rem)] font-[700] leading-[1.05] tracking-normal text-white/95">Construyamos algo que funcione.</h2></div>
    <span class="text-[0.82rem] leading-[1.7] text-muted min-[820px]:justify-self-end">Disponible para oportunidades de desarrollo, sistemas y automatización.</span>
  </div>

  <div class="mt-8 grid overflow-hidden rounded-lg border border-white/[0.1] bg-[rgba(8,15,29,0.66)] shadow-[0_1.25rem_3rem_rgba(0,0,0,0.16)] motion-safe:animate-[fade-in-up_0.65s_ease-out_both] motion-reduce:animate-none min-[820px]:grid-cols-[minmax(0,1.18fr)_minmax(18rem,0.82fr)]">
    <div class="flex min-w-0 flex-col justify-center px-5 py-8 sm:px-8 sm:py-10 min-[820px]:border-r min-[820px]:border-white/[0.1]">
      <span class="inline-flex items-center gap-2 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-white/50"><i class="h-2 w-2 rounded-full bg-accent-warm2 shadow-[0_0_12px_rgba(45,212,191,0.65)]"></i> Respondo directamente</span>
      <a class="mt-4 [overflow-wrap:anywhere] text-[clamp(1rem,2.7vw,1.65rem)] font-semibold leading-[1.35] text-white hover:text-accent2" href={`mailto:${emailUrl}`}>{emailUrl}</a>
      <button type="button" class="mt-6 inline-flex min-h-10 w-fit items-center gap-3 rounded-md border border-white/15 bg-white/[0.035] px-3.5 py-2 font-mono text-[0.64rem] font-semibold uppercase tracking-[0.08em] text-white/70 transition-[transform,border-color,color,background-color] duration-200 hover:-translate-y-0.5 hover:border-accent2/40 hover:bg-white/[0.06] hover:text-white" data-copy-email={emailUrl} aria-live="polite">Copiar email <span class="text-accent2" aria-hidden="true">+</span></button>
    </div>

    <nav class="grid" aria-label="Perfiles profesionales">
      {socialChannels.map((channel) => (
        <a class:list={["group grid min-h-[5.6rem] grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3 border-b border-white/[0.08] px-5 py-4 text-white/80 transition-[background-color,color] duration-200 last:border-b-0 hover:bg-white/[0.04] hover:text-white sm:px-6", getIconColorClass(channel.name)]} href={channel.url} target="_blank" rel="noreferrer" aria-label={`${channel.cta}: ${channel.name}`}>
          <span class="grid h-10 w-10 place-items-center rounded-md border border-white/[0.09] bg-[rgba(8,15,29,0.72)] transition-[border-color,background-color] duration-200 group-hover:border-[var(--item-color)] group-hover:bg-white/[0.07]"><img class="h-[1.15rem] w-[1.15rem] object-contain" src={iconMap[channel.icon]} alt="" /></span>
          <span class="grid min-w-0 gap-1"><small class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-white/55">{channel.id} · {channel.name}</small><strong class="truncate text-[0.76rem] font-semibold">{channel.displayValue}</strong></span>
          <i class="external-link-icon text-white/55 transition-colors duration-200 group-hover:text-[var(--item-color)]" aria-hidden="true"></i>
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  const initEmailCopy = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        const email = button.dataset.copyEmail;
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          const original = button.innerHTML;
          button.textContent = 'Email copiado';
          window.setTimeout(() => { button.innerHTML = original; }, 1800);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    });
  };

  initEmailCopy();
  document.addEventListener('astro:page-load', initEmailCopy);
</script>
