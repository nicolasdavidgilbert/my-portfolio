---
import type { Project } from '../../types/project';
import T from '../i18n/T.astro';
import ProjectSlide from './ProjectSlide.astro';
import { readableAccent } from '../../utils/color';
import { themeColors } from '../../data/site';
import { projectKey } from '../../i18n/project-keys';
import { i18nAttrs } from '../../i18n/translate';

interface Props {
  projects: readonly Project[];
}

const { projects } = Astro.props;
const pad = (value: number) => String(value).padStart(2, '0');
const AUTOPLAY_MS = 7000;
const firstAccent = projects[0]?.accent ?? themeColors.accent;
const firstAccentText = readableAccent(firstAccent);
---

<div
  class="carousel relative"
  style={`--carousel-accent:${firstAccent};--carousel-accent-text:${firstAccentText};--autoplay:${AUTOPLAY_MS}ms`}
  data-carousel
  data-paused
>
  <div class="carousel-ambient" aria-hidden="true"></div>
  <div class="grid-floor opacity-50" aria-hidden="true"></div>

  <div
    class="track"
    data-track
    role="region"
    {...i18nAttrs({ 'aria-roledescription': 'carousel.roleCarousel', 'aria-label': 'carousel.regionLabel' })}
    tabindex="0"
  >
    {projects.map((project, index) => (
      <ProjectSlide project={project} index={index} total={projects.length} />
    ))}
  </div>

  <div class="relative mx-auto mt-4 grid w-full max-w-page grid-cols-[minmax(0,1fr)] gap-5 px-gutter sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-4">
      <p class="flex items-baseline gap-2 font-mono text-fg-subtle" aria-hidden="true">
        <span class="counter text-4xl font-bold text-fg sm:text-5xl" data-counter>
          01
        </span>
        <span class="text-sm">/ {pad(projects.length)}</span>
      </p>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="carousel-btn"
          data-toggle
          {...i18nAttrs({ 'aria-label': 'carousel.pause' })}
          hidden
        >
          <span class="icon-pause" aria-hidden="true">
            ❚❚
          </span>
          <span class="icon-play" aria-hidden="true">
            ▶
          </span>
        </button>
        <button type="button" class="carousel-btn" data-prev {...i18nAttrs({ 'aria-label': 'carousel.previous' })}>
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          class="carousel-btn carousel-btn--primary"
          data-next
          {...i18nAttrs({ 'aria-label': 'carousel.next' })}
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <nav {...i18nAttrs({ 'aria-label': 'carousel.tabsLabel' })}>
      <ul class="tabs">
        {projects.map((project, index) => (
          <li>
            <a
              href={`#${project.id}`}
              class="tab"
              style={`--accent:${project.accent};--accent-text:${readableAccent(project.accent)}`}
              data-tab={index}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span class="tab-meta">
                <i aria-hidden="true"></i>
                {pad(index + 1)} · {project.kind}
              </span>
              <span class="tab-name">
                <T k={projectKey(project.id, 'name')} />
              </span>
              <span class="tab-bar" aria-hidden="true">
                <span data-bar></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  .carousel {
    transition: --carousel-accent 0.9s ease;
  }

  .carousel-ambient {
    position: absolute;
    inset: -10% 0 20%;
    pointer-events: none;
    background:
      radial-gradient(40% 50% at 50% 45%, color-mix(in srgb, var(--carousel-accent) 22%, transparent), transparent 70%),
      radial-gradient(30% 40% at 15% 60%, color-mix(in srgb, var(--carousel-accent) 10%, transparent), transparent 70%),
      radial-gradient(30% 40% at 85% 60%, color-mix(in srgb, var(--carousel-accent) 10%, transparent), transparent 70%);
    filter: blur(20px);
  }

  .track {
    --slide-w: min(86vw, 68rem);
    position: relative;
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 2.5rem 3.5rem;
    padding-inline: calc(50% - var(--slide-w) / 2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline: none;
    cursor: grab;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  /* Snapping stays off while a released drag glides into place (see project-carousel.ts). */
  .track.is-settling {
    scroll-snap-type: none;
  }

  .counter {
    color: var(--carousel-accent-text);
    transition: color 0.6s;
  }

  .carousel-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-btn:hover {
    border-color: var(--carousel-accent);
    transform: scale(1.08);
  }

  .carousel-btn--primary {
    border-color: transparent;
    background: var(--carousel-accent-text);
    color: var(--color-accent-contrast);
  }

  .carousel-btn[data-toggle] {
    font-size: 0.7rem;
  }

  .icon-play,
  [data-paused-by-user] .icon-pause {
    display: none;
  }

  [data-paused-by-user] .icon-play {
    display: inline;
  }

  .tabs {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(11rem, 1fr);
    gap: 0.5rem;
    /* Room for the hover lift: overflow-x also clips vertically, so pad and pull back. */
    padding-block: 0.375rem;
    margin-block: -0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs > li {
    scroll-snap-align: start;
  }

  .tab {
    position: relative;
    display: grid;
    gap: 0.2rem;
    min-height: 4rem;
    padding: 0.7rem 0.85rem 0.9rem;
    overflow: hidden;
    border-radius: 0.6rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    transition:
      border-color 0.3s,
      background-color 0.3s,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tab:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
  }

  .tab[aria-current] {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, var(--color-surface));
  }

  .tab-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-subtle);
  }

  .tab-meta i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.5;
  }

  .tab[aria-current] .tab-meta {
    color: var(--accent-text);
  }

  .tab[aria-current] .tab-meta i {
    opacity: 1;
    box-shadow: 0 0 10px var(--accent);
  }

  .tab-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .tab[aria-current] .tab-name {
    color: var(--color-fg);
  }

  .tab-bar {
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: transparent;
    transition: background-color 0.3s;
  }

  .tab[aria-current] .tab-bar {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .tab-bar > span {
    display: block;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .tab[aria-current] .tab-bar > span {
    transform: scaleX(1);
  }

  /* Autoplay: the active tab's bar fills left-to-right over --autoplay and its end advances the carousel. */
  .tab-bar > span.is-running {
    animation: tab-fill var(--autoplay) linear forwards;
  }

  [data-paused] .tab-bar > span.is-running {
    animation-play-state: paused;
  }

  @keyframes tab-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import '../../scripts/project-carousel';
  import '../../scripts/project-links';
</script>
