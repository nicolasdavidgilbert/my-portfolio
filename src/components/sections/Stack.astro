---
import Section from '../common/Section.astro';
import TechMarquee from '../ui/TechMarquee.astro';
import { technologyRows } from '../../data/skills';
---

<Section id="stack" index="05" label="Stack" title="Tecnologías con las que trabajo">
  <p slot="intro" class="mt-5 text-lg leading-relaxed text-fg-muted">
    Agrupadas por área, empezando por las que más definen mi perfil. Pasa el ratón para pausar.
  </p>

  <div slot="bleed" class="grid gap-8">
    {technologyRows.map((row, index) => (
      <div data-reveal="left" style={`--reveal-delay:${index * 120}ms`}>
        <TechMarquee row={row} reverse={index % 2 === 1} duration={60 + index * 8} />
      </div>
    ))}
  </div>
</Section>
