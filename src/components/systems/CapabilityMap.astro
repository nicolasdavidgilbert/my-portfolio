---
import type { Capability } from '../../types/technology';

interface Props {
  capabilities: readonly Capability[];
}

const { capabilities } = Astro.props;
---

<div>
  <h3 class="label text-fg-subtle">Dónde comprobarlo</h3>
  <dl class="mt-4 divide-y divide-border border-y border-border">
    {capabilities.map((capability, index) => (
      <div class="group grid gap-1 py-4 transition-colors hover:bg-surface/60 md:grid-cols-[12rem_1fr_auto] md:items-baseline md:gap-6 md:px-3" data-reveal style={`--reveal-delay:${index * 80}ms`}>
        <dt class="font-medium text-fg transition-colors group-hover:text-accent">{capability.area}</dt>
        <dd class="text-fg-muted">{capability.practice}</dd>
        <dd class="font-mono text-sm">
          <a href={capability.evidence.href} class="inline-flex min-h-8 items-center text-accent underline-offset-4 hover:underline">
            <span aria-hidden="true">→ </span>{capability.evidence.label}
          </a>
        </dd>
      </div>
    ))}
  </dl>
</div>
