---
import type { TerminalLine } from '../../types/project';

interface Props {
  lines: readonly TerminalLine[];
  prompt?: string;
}

const { lines, prompt = '$' } = Astro.props;
---

<div class="space-y-1 p-4 font-mono text-[0.8125rem] leading-relaxed sm:p-5">
  {lines.map((line) => (
    <p
      class:list={[
        'break-words whitespace-pre-wrap',
        line.kind === 'command' && 'text-fg',
        line.kind === 'output' && 'text-fg-muted',
        line.kind === 'comment' && 'text-fg-subtle',
      ]}
    >
      {line.kind === 'command' && (
        <span class="mr-2 text-accent select-none" aria-hidden="true">
          {prompt}
        </span>
      )}
      {line.text}
    </p>
  ))}
</div>
