---
import Section from '../common/Section.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import StatusDot from '../ui/StatusDot.astro';
import { SITE_HOST, person } from '../../data/site';
import { getSocialLink } from '../../data/socialLinks';

const email = getSocialLink('email');
const github = getSocialLink('github');
const linkedin = getSocialLink('linkedin');
const areas = ['Desarrollo', 'Sistemas', 'Automatización'] as const;
---

<Section id="contacto" label="Contacto" size="display" layout="split" class="pb-10 lg:pt-28 lg:pb-10">
  <Fragment slot="background">
    <div class="grid-floor opacity-30" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -bottom-40 left-1/2 h-[34rem] w-[64rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-accent)_7%,transparent),transparent)] blur-2xl"
      aria-hidden="true"
    ></div>
  </Fragment>

  <Fragment slot="title">
    Construyamos <span class="text-gradient">algo útil.</span>
  </Fragment>

  <p slot="intro" class="mt-6 max-w-prose text-lg leading-relaxed text-fg-muted">
    Disponible para oportunidades de desarrollo, sistemas y automatización. Respondo directamente.
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    {person.available && (
      <span class="label inline-flex items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3 py-1.5 text-fg">
        <StatusDot pulse /> Disponible
      </span>
    )}
    <span class="label rounded-full border border-border px-3 py-1.5 text-fg-muted">{person.location}</span>
    {areas.map((area) => (
      <span class="label rounded-full border border-border px-3 py-1.5 text-fg-muted">{area}</span>
    ))}
  </div>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a
      href={email.href}
      class="group inline-flex min-h-12 items-center gap-2.5 rounded-md bg-accent px-5 text-base font-medium text-accent-contrast transition-colors duration-200 hover:bg-accent/90"
    >
      <Icon name="email" class="size-[1.125rem]" />
      Escríbeme
      <Icon
        name="arrow-up-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </a>
    <button type="button" class="copy-btn" data-copy-email={person.email} hidden>
      <span class="copy-idle inline-flex items-center gap-2">
        <Icon name="copy" /> Copiar email
      </span>
      <span class="copy-done inline-flex items-center gap-2">
        <Icon name="check" /> Copiado
      </span>
    </button>
    <span class="sr-only" role="status" data-copy-status></span>
  </div>

  <div slot="aside" data-reveal style="--reveal-delay:120ms">
    <div class="tilt" data-tilt="0.15">
      <div class="contact-terminal">
        <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-3 font-mono text-xs text-fg-subtle">
          <span>nico@{SITE_HOST}:~</span>
          <span class="flex gap-1.5" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
        </div>

        <div class="p-5 sm:p-6">
          <p class="font-mono text-sm text-fg-muted">
            <span class="text-success">$</span> <span class="text-fg">contact --list</span>
          </p>

          <ul class="mt-4 grid gap-1.5">
            <li>
              <a href={email.href} class="contact-row">
                <span class="contact-key">email</span>
                <span class="contact-value">{person.email}</span>
                <Icon name="email" class="contact-icon" />
              </a>
            </li>
            {[github, linkedin].map((link) => (
              <li>
                <ExternalLink href={link.href} class="contact-row">
                  <span class="contact-key">{link.id}</span>
                  <span class="contact-value">{link.display}</span>
                  <Icon name="arrow-up-right" class="contact-icon" />
                </ExternalLink>
              </li>
            ))}
          </ul>

          <p class="mt-5 border-t border-border pt-4 font-mono text-sm" aria-hidden="true">
            <span class="text-success">$</span> <span class="prompt-cursor"></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <a
    slot="bleed"
    href="#top"
    class="group relative mx-auto mt-section flex w-fit items-center gap-2 rounded-full border border-border px-4 py-2 font-mono text-xs text-fg-subtle transition-colors hover:border-border-strong hover:text-fg lg:mt-36"
  >
    <Icon name="arrow-up" class="size-3.5 transition-transform duration-300 group-hover:-translate-y-0.5" />
    volver arriba
  </a>
</Section>

<style>
  .copy-btn {
    display: inline-grid;
    min-height: 3rem;
    align-items: center;
    padding-inline: 1.1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border-strong);
    font-size: 0.95rem;
    color: var(--color-fg);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s;
  }

  .copy-btn[hidden] {
    display: none;
  }

  .copy-btn:hover {
    border-color: var(--color-fg-subtle);
    background: var(--color-surface);
  }

  .copy-idle,
  .copy-done {
    grid-area: 1 / 1;
    transition:
      opacity 0.25s,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copy-done {
    opacity: 0;
    transform: translateY(6px);
    color: var(--color-success);
  }

  .copy-btn.is-copied {
    border-color: color-mix(in srgb, var(--color-success) 60%, transparent);
  }

  .copy-btn.is-copied .copy-idle {
    opacity: 0;
    transform: translateY(-6px);
  }

  .copy-btn.is-copied .copy-done {
    opacity: 1;
    transform: none;
  }

  .contact-terminal {
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.8);
  }

  .contact-terminal [aria-hidden] i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-border-strong);
  }

  .contact-terminal :global(.contact-row) {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition:
      background-color 0.2s,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-terminal :global(.contact-row:hover) {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .contact-terminal :global(.contact-key) {
    color: var(--color-fg-subtle);
  }

  .contact-terminal :global(.contact-row:hover .contact-key) {
    color: var(--color-accent);
  }

  .contact-terminal :global(.contact-value) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-fg);
  }

  .contact-terminal :global(.contact-row .contact-icon) {
    width: 1rem;
    height: 1rem;
    color: var(--color-fg-subtle);
    transition: color 0.2s;
  }

  .contact-terminal :global(.contact-row:hover .contact-icon) {
    color: var(--color-accent);
  }

  @media (max-width: 30rem) {
    .contact-terminal :global(.contact-row) {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .contact-terminal :global(.contact-key) {
      grid-column: 1 / -1;
      font-size: 0.7rem;
    }
  }

  .prompt-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .prompt-cursor {
      animation: cursor-blink 1.1s steps(1) infinite;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (button && status && navigator.clipboard) {
    button.hidden = false;
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        button.classList.add('is-copied');
        status.textContent = 'Email copiado';
      } catch {
        status.textContent = 'No se pudo copiar el email';
      }
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style is:global>
  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }
</style>
