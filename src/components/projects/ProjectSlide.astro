---
import type { Project } from '../../types/project';
import T from '../i18n/T.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import TechBadge from '../ui/TechBadge.astro';
import ProjectMetadata from './ProjectMetadata.astro';
import ProjectVisual from './ProjectVisual.astro';
import { readableAccent } from '../../utils/color';
import { highlightKeys, projectKey } from '../../i18n/project-keys';
import { i18nAttrs } from '../../i18n/translate';

interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const headingId = `${project.id}-title`;
const demoHost = project.demo ? new URL(project.demo).host : undefined;
const number = String(index + 1).padStart(2, '0');
const accentText = readableAccent(project.accent);
const nameKey = projectKey(project.id, 'name');
---

<article
  id={project.id}
  class="slide"
  style={`--accent:${project.accent};--accent-text:${accentText}`}
  data-slide
  aria-labelledby={headingId}
  {...i18nAttrs(
    { 'aria-roledescription': 'carousel.roleSlide', 'aria-label': 'carousel.slideLabel' },
    { n: index + 1, total },
  )}
>
  <div class="slide-card glow-border" data-slide-card>
    <div class="slide-visual">
      <span class="slide-number" aria-hidden="true">
        {number}
      </span>
      <span class="slide-kind" aria-hidden="true">
        {project.kind}
      </span>
      <div class="slide-stage" data-tilt="0.6">
        <div class="tilt">
          <ProjectVisual visual={project.visual} host={demoHost} nameKey={nameKey} />
        </div>
      </div>
    </div>

    <div class="slide-body">
      <div class="stagger">
        <ProjectMetadata index={index} category={projectKey(project.id, 'category')} date={project.date} />
        <h3 id={headingId} class="mt-3 text-2xl font-semibold tracking-tight text-fg sm:text-4xl">
          <T k={nameKey} />
        </h3>
        <T as="p" k={projectKey(project.id, 'tagline')} class="mt-2 text-lg text-fg-muted" />
        <T as="p" k={projectKey(project.id, 'problem')} class="mt-4 leading-relaxed text-fg-muted" />

        <ul class="mt-5 space-y-2 text-[0.9375rem] leading-relaxed text-fg">
          {highlightKeys(project.id).map((highlight) => (
            <li class="grid grid-cols-[1rem_1fr] gap-2">
              <span class="font-mono text-accent" aria-hidden="true">
                ›
              </span>
              <T k={highlight} />
            </li>
          ))}
        </ul>

        <ul
          class="mt-6 flex flex-wrap gap-2"
          {...i18nAttrs({ 'aria-label': 'projectUi.stackOf' }, { name: { k: nameKey } })}
        >
          {project.stack.map((tech) => (
            <li>
              <TechBadge label={tech} />
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          {project.demo && (
            <ButtonLink href={project.demo} variant="primary" external>
              <T k="projectUi.demo" />
              <T k="projectUi.ofProject" vars={{ name: { k: nameKey } }} class="sr-only" />
            </ButtonLink>
          )}
          <ButtonLink href={project.repo} variant="secondary" icon="github" external>
            <T k="projectUi.code" />
            <T k="projectUi.ofProject" vars={{ name: { k: nameKey } }} class="sr-only" />
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .slide {
    /* Every accent-based utility inside the card takes the project colour. */
    --color-accent: var(--accent-text);
    flex: 0 0 var(--slide-w);
    scroll-snap-align: center;
    transform-style: preserve-3d;
  }

  :global(.slide:not(.is-active)) {
    cursor: pointer;
  }

  :global(.slide:not(.is-active)):hover .slide-card {
    --dim-hover: -0.25;
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .slide-card {
    --glow-color: var(--accent);
    --glow-opacity: 0;
    --glow-width: 2px;
    position: relative;
    display: grid;
    height: 100%;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow:
      0 50px 100px -50px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(255 255 255 / 0.02) inset;
    transition:
      box-shadow 0.6s,
      border-color 0.3s;
    transform: perspective(1800px) translateZ(var(--z, 0px)) rotateY(var(--turn, 0deg)) scale(var(--scale, 1));
    will-change: transform;
  }

  /* Side cards are dimmed with an overlay rather than opacity so the glow stays crisp. */
  .slide-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    background: var(--color-bg);
    opacity: max(0, calc(var(--dim, 0) + var(--dim-hover, 0)));
    transition: opacity 0.3s;
    pointer-events: none;
    border-radius: inherit;
  }

  :global(.slide.is-active) .slide-card {
    --glow-opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow:
      0 50px 100px -50px rgb(0 0 0 / 0.9),
      0 0 80px -30px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .slide-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: clamp(2.75rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 30% 20%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(60% 60% at 90% 100%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .slide-number {
    position: absolute;
    left: clamp(1rem, 3vw, 1.75rem);
    bottom: -0.15em;
    font-family: var(--font-mono);
    font-size: clamp(6rem, 14vw, 11rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 40%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .slide-kind {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, var(--color-bg));
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .slide-stage {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 40rem;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }

  .slide-body {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  @media (min-width: 64rem) {
    .slide-card {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .slide-visual {
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .slide-body {
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stagger > :global(*) {
      opacity: 0.2;
      transform: translate3d(0, 14px, 0);
      transition:
        opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.slide.is-active) .stagger > :global(*) {
      opacity: 1;
      transform: none;
    }

    :global(.slide.is-active) .stagger > :global(*:nth-child(2)) {
      transition-delay: 60ms;
    }
    :global(.slide.is-active) .stagger > :global(*:nth-child(3)) {
      transition-delay: 110ms;
    }
    :global(.slide.is-active) .stagger > :global(*:nth-child(4)) {
      transition-delay: 160ms;
    }
    :global(.slide.is-active) .stagger > :global(*:nth-child(5)) {
      transition-delay: 210ms;
    }
    :global(.slide.is-active) .stagger > :global(*:nth-child(6)) {
      transition-delay: 260ms;
    }
    :global(.slide.is-active) .stagger > :global(*:nth-child(7)) {
      transition-delay: 310ms;
    }
  }
</style>
