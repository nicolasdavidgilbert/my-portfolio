---
import LanguageToggle from '../i18n/LanguageToggle.astro';
import T from '../i18n/T.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import { cvFilename, cvUrl, navigation, person } from '../../data/site';
import { getSocialLink } from '../../data/socialLinks';
import { i18nAttrs } from '../../i18n/translate';

const profileLinks = [getSocialLink('github'), getSocialLink('linkedin')];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md">
  <span
    class="absolute inset-x-0 bottom-[-1px] h-px origin-left scale-x-0 bg-linear-to-r from-accent to-accent-warm"
    data-scroll-progress
    aria-hidden="true"
  ></span>
  <div class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-6 px-gutter sm:px-6 lg:px-8">
    <a href="#top" class="flex min-h-11 items-center gap-2 text-sm font-semibold text-fg">
      <span class="font-mono text-accent" aria-hidden="true">
        ~$
      </span>
      {person.shortName}
    </a>

    <nav {...i18nAttrs({ 'aria-label': 'a11y.mainNav' })} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              class="relative rounded-md px-3 py-2 text-sm text-fg-muted transition-colors after:absolute after:inset-x-3 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:text-fg hover:after:scale-x-100 aria-[current]:text-fg aria-[current]:after:scale-x-100"
            >
              <T k={item.label} />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageToggle />

      <div class="hidden items-center gap-1 lg:flex">
        {profileLinks.map((link) => (
          <ExternalLink
            href={link.href}
            class="grid size-10 place-items-center rounded-md text-fg-muted transition-colors hover:bg-surface hover:text-fg"
          >
            <Icon name={link.id} class="size-[1.125rem]" />
            <span class="sr-only">{link.label}</span>
          </ExternalLink>
        ))}
        {cvUrl && (
          <a
            href={cvUrl}
            download={cvFilename}
            class="ml-2 rounded-md border border-border-strong px-3 py-1.5 font-mono text-xs text-fg hover:border-fg-subtle"
          >
            CV
          </a>
        )}
      </div>

      <details class="group lg:hidden" data-mobile-nav>
        <summary class="grid size-11 cursor-pointer list-none [&::-webkit-details-marker]:hidden place-items-center rounded-md border border-border text-fg hover:bg-surface">
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="close" class="hidden size-5 group-open:block" />
          <T k="a11y.menu" class="sr-only" />
        </summary>
        <div class="absolute inset-x-0 top-16 border-b border-border bg-bg px-gutter pb-6 sm:px-6">
          <nav {...i18nAttrs({ 'aria-label': 'a11y.mobileNav' })}>
            <ul class="divide-y divide-border">
              {navigation.map((item) => (
                <li>
                  <a href={item.href} class="flex min-h-12 items-center text-base text-fg">
                    <T k={item.label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <ul class="mt-4 flex flex-wrap gap-2">
            {profileLinks.map((link) => (
              <li>
                <ExternalLink
                  href={link.href}
                  class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-3 text-sm text-fg-muted hover:text-fg"
                >
                  <Icon name={link.id} />
                  {link.label}
                </ExternalLink>
              </li>
            ))}
            {cvUrl && (
              <li>
                <a
                  href={cvUrl}
                  download={cvFilename}
                  class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-3 text-sm text-fg-muted hover:text-fg"
                >
                  <Icon name="file" />
                  CV
                </a>
              </li>
            )}
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');

  if (menu) {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
