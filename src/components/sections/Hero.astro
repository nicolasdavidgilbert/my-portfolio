---
import ButtonLink from '../ui/ButtonLink.astro';
import Icon from '../ui/Icon.astro';
import StatusDot from '../ui/StatusDot.astro';
import HeroVisual from '../hero/HeroVisual.astro';
import { cvUrl, person } from '../../data/site';
import { getSocialLink } from '../../data/socialLinks';

const github = getSocialLink('github');
const linkedin = getSocialLink('linkedin');
---

<section aria-labelledby="hero-title" class="spotlight relative overflow-clip">
  <div class="grid-floor" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-[20%] h-[36rem] w-[50rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-accent)_14%,transparent),transparent)] blur-2xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-10 right-[-10%] h-[40rem] w-[40rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-success)_10%,transparent),transparent)] blur-2xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-page px-gutter pt-8 pb-section sm:px-6 lg:px-8 lg:pb-32">
    <div class="hero-in label flex flex-wrap items-center justify-between gap-3 text-fg-muted" style="--d:0ms">
      {person.available && (
        <span class="inline-flex items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3 py-1 text-fg">
          <StatusDot pulse /> Disponible para oportunidades
        </span>
      )}
      <span>{person.location}</span>
    </div>

    <div class="mt-12 grid items-center gap-12 lg:mt-16 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-10">
      <div>
        <h1 id="hero-title">
          <span class="hero-in block text-base font-medium text-fg-muted sm:text-lg" style="--d:60ms">
            {person.fullName}
          </span>
          <span class="mt-5 block text-[clamp(2.5rem,4.7vw,4.25rem)] leading-[1] font-semibold tracking-tight" lang="en">
            <span class="hero-in block text-fg" style="--d:130ms">Software Developer</span>
            <span class="hero-in my-2 block text-[0.5em] font-normal text-fg-subtle" style="--d:190ms">&amp;</span>
            <span class="hero-in block" style="--d:250ms"><span class="hero-gradient">Systems Administrator.</span></span>
          </span>
        </h1>

        <p class="hero-in mt-8 max-w-prose text-lg leading-relaxed text-fg-muted" style="--d:330ms">
          Construyo aplicaciones completas y administro la infraestructura que las mantiene en marcha.
          Combino desarrollo, Linux, redes e integración de IA con una visión práctica de producto.
        </p>

        <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d:410ms">
          <ButtonLink href="#proyectos" variant="primary" class="group">
            Ver proyectos
            <Icon name="arrow-down" class="size-4 transition-transform duration-300 group-hover:translate-y-0.5" />
          </ButtonLink>
          <ButtonLink href={github.href} icon="github" external>
            {github.label}
          </ButtonLink>
          <ButtonLink href={linkedin.href} variant="text" external class="ml-1">
            {linkedin.label}
          </ButtonLink>
          {cvUrl && (
            <ButtonLink href={cvUrl} variant="text" class="ml-1">
              CV
            </ButtonLink>
          )}
        </div>
      </div>

      <div class="hero-in" style="--d:220ms">
        <HeroVisual />
      </div>
    </div>
  </div>

  <a
    href="#perfil"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-xs text-fg-subtle transition-colors hover:text-fg lg:flex"
  >
    scroll
    <span class="scroll-cue" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero-gradient {
    background: linear-gradient(100deg, var(--color-accent) 0%, #ff8a5c 50%, var(--color-accent) 100%);
    background-size: 160% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .scroll-cue {
    width: 1.25rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    position: relative;
  }

  .scroll-cue::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.4rem;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--d, 0ms);
    }

    .hero-gradient {
      animation: gradient-pan 7s ease-in-out infinite alternate;
    }

    .scroll-cue::after {
      animation: cue 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
      filter: blur(6px);
    }
  }

  @keyframes cue {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }
</style>
