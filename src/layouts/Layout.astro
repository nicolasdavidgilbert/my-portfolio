---
// src/layouts/Layout.astro
import '../styles/global.css';   // <— importa el CSS para que pase por Tailwind/PostCSS
const {
    title = "Portfolio — Git log style",
    description = "Dev Multiplataforma",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="shortcut icon" href="/favicon.svg" />
        <link rel="mask-icon" href="/favicon.svg" color="#60a5fa" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@300;400;600;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="font-sans min-h-screen flex flex-col">
        <header
            class="sticky top-0 z-10 backdrop-blur border-b border-border bg-[rgba(10,15,29,0.85)]"
        >
            <div
                class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between gap-3"
            >
                <div class="flex items-center gap-2">
                    <div
                        class="w-9 h-9 grid place-items-center rounded-lg border border-border bg-gradient-to-br from-[#0d1530] to-[#070c18] shadow-[inset_0_0_24px_rgba(59,130,246,0.18)]"
                    >
                        <a href="#"><img src="/favicon.svg" alt="Nico logo" class="w-5 h-5" /></a>
                    </div>
                    <strong>Nico</strong>
                    <span class="text-muted">/ Dev Multiplataforma</span>
                </div>
                <!-- Mobile: collapsible nav -->
                <details class="md:hidden relative group">
                    <summary class="flex items-center gap-2 px-3 py-2 rounded-md cursor-pointer bg-[rgba(255,255,255,0.02)] group-open:bg-[rgba(255,255,255,0.03)]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#bcd3ff] group-open:rotate-90 transition-transform duration-150" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </summary>
                    <!-- absolute panel so header doesn't grow when opened -->
                    <div class="absolute right-3 top-full mt-2 w-44 bg-[rgba(8,12,20,0.95)] border border-[#203157] rounded-md shadow-lg z-40 p-2">
                        <div class="flex flex-col gap-2">
                            <a class="btn w-full text-left" href="#readme" onclick="this.closest('details').open=false">README</a>
                            <a class="btn w-full text-left" href="#log" onclick="this.closest('details').open=false">Commits</a>
                            <a class="btn w-full text-left" href="#tags" onclick="this.closest('details').open=false">Tags</a>
                            <a class="btn btn-primary w-full text-left" href="#contacto" onclick="this.closest('details').open=false">Contacto</a>
                        </div>
                    </div>
                </details>

                <!-- Desktop nav -->
                <nav class="hidden md:flex gap-3 text-sm">
                    <a class="btn" href="#readme">README</a>
                    <a class="btn" href="#log">Commits</a>
                    <a class="btn" href="#tags">Tags</a>
                    <a class="btn btn-primary" href="#contacto">Contacto</a>
                </nav>
            </div>
        </header>
        <main class="flex-1 flex items-center justify-center">
            <div class="w-full max-w-5xl mx-auto px-6">
                <slot />
            </div>
        </main>
        <footer
            class="max-w-5xl mx-auto px-6 mt-7 mb-2 border-t border-border text-muted py-4 text-sm"
        >
            © {new Date().getFullYear()} Nico · Portfolio Nico David Gilbert González
        </footer>
    </body>
</html>
