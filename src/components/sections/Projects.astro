---
import Section from '../common/Section.astro';
import T from '../i18n/T.astro';
import ProjectCarousel from '../projects/ProjectCarousel.astro';
import { projects } from '../../data/projects';
---

<Section id="projects" label="nav.projects" title="projectsSection.title">
  <T slot="intro" as="p" k="projectsSection.intro" class="mt-5 text-lg leading-relaxed text-fg-muted" />

  <div slot="bleed" data-reveal="zoom">
    <ProjectCarousel projects={projects} />
  </div>
</Section>
