---
import Section from '../common/Section.astro';
import T from '../i18n/T.astro';
import Timeline from '../profile/Timeline.astro';
import SystemStatus from '../systems/SystemStatus.astro';
import { experience } from '../../data/experience';
import { i18nAttrs } from '../../i18n/translate';
import type { TranslationKey } from '../../i18n/types';

const pillars = [
  {
    label: 'Development',
    glyph: '</>',
    text: 'about.pillars.development',
  },
  {
    label: 'Systems',
    glyph: '>_',
    text: 'about.pillars.systems',
  },
  {
    label: 'Automation',
    glyph: '⟳',
    text: 'about.pillars.automation',
  },
] as const satisfies readonly { label: string; glyph: string; text: TranslationKey }[];
---

<Section id="about" label="nav.about" title="about.title">
  <T slot="intro" as="p" k="about.intro" class="mt-5 text-lg leading-relaxed text-fg-muted" />

  <ul class="grid gap-4 sm:grid-cols-3">
    {pillars.map((pillar, index) => (
      <li data-reveal="tilt" style={`--reveal-delay:${index * 110}ms`}>
        <div
          class="tilt spotlight group h-full rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent/50"
          data-tilt
        >
          <span
            class="grid size-11 place-items-center rounded-md border border-accent/30 bg-accent/10 font-mono text-accent transition-transform duration-500 [transform:translateZ(30px)] group-hover:scale-110"
            aria-hidden="true"
          >
            {pillar.glyph}
          </span>
          <h3 class="label mt-5 text-fg [transform:translateZ(20px)]" lang="en">
            {pillar.label}
          </h3>
          <T as="p" k={pillar.text} class="mt-2 leading-relaxed text-fg-muted" />
        </div>
      </li>
    ))}
  </ul>

  <div id="journey" class="mt-16 grid scroll-mt-24 gap-10 lg:mt-20 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
    <div>
      <header class="mb-8" data-reveal>
        <p class="label flex items-center gap-3 text-fg-subtle">
          <span class="h-px w-6 bg-border-strong" aria-hidden="true"></span>
          <T k="about.journeyLabel" />
        </p>
        <T as="h3" k="about.journeyTitle" class="mt-3 text-2xl font-semibold tracking-tight text-fg sm:text-3xl" />
      </header>
      <Timeline entries={experience} />
    </div>

    <aside
      class="lg:sticky lg:top-24 lg:self-start"
      data-reveal="zoom"
      style="--reveal-delay:200ms"
      {...i18nAttrs({ 'aria-label': 'about.statusLabel' })}
    >
      <div class="tilt" data-tilt="0.6">
        <SystemStatus />
      </div>
    </aside>
  </div>
</Section>
