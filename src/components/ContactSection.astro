---
import type { ContactProps } from '../data/contact';
import { iconMap, getContactChannels } from '../data/contact';

const { repoUrl, linkedinUrl, emailUrl } = Astro.props as ContactProps;
const contactChannels = getContactChannels({ repoUrl, linkedinUrl, emailUrl });
---

<section id="contacto" class="scroll-mt-24 py-16">
  <div class="mb-12 max-w-2xl reveal">
    <p class="mb-2 font-mono text-sm uppercase tracking-widest text-accent-warm/80">
      Contacto
    </p>

    <h2 class="bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl">
      Canales directos, sin intermediarios.
    </h2>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {contactChannels.map((channel) => (
      <a
        href={channel.url}
        target={channel.name !== "Email" ? "_blank" : undefined}
        rel={channel.name !== "Email" ? "noreferrer" : undefined}
        aria-label={`${channel.cta}: ${channel.name}`}
        class:list={[
          "group relative min-h-[210px] overflow-hidden rounded-3xl border border-white/10 bg-slate-950/55 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.22)] backdrop-blur-xl transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--platform-color)] hover:bg-slate-900",
          channel.delay
        ]}
        style={{
          '--platform-color': channel.color,
          '--platform-glow': `${channel.color}22`
        }}
      >
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,var(--platform-glow),transparent_42%)] opacity-70 transition-opacity duration-500 group-hover:opacity-100" />
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent" />

        <div class="relative z-10 flex h-full flex-col justify-between">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="grid h-11 w-11 place-items-center rounded-2xl border border-white/10 bg-white/[0.04] p-2 shadow-[inset_0_0_20px_rgba(255,255,255,0.04)] transition-all duration-300 group-hover:scale-105 group-hover:border-[var(--platform-color)]">
                <img src={iconMap[channel.icon]} alt={channel.name} class="h-full w-full object-contain" />
              </span>

              <span class="font-mono text-xs font-bold uppercase tracking-widest text-slate-600 transition-colors duration-300 group-hover:text-[var(--platform-color)]">
                {channel.id}
              </span>
            </div>
          </div>

          <div class="mt-10">
            <h3 class="text-2xl font-bold tracking-tight text-slate-100">
              {channel.name}
            </h3>

            <p class="mt-2 truncate text-sm font-medium text-slate-500 transition-colors duration-300 group-hover:text-slate-300">
              {channel.displayValue}
            </p>

            <p class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--platform-color)] opacity-85 transition-all duration-300 group-hover:gap-3 group-hover:opacity-100">
              {channel.cta}
              <span aria-hidden="true">→</span>
            </p>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>