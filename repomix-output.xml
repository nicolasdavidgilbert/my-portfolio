import { iconColors } from './iconColors';
export { iconColors } from './iconColors';

export interface ContactChannel {
  id: string;
  name: string;
  url: string;
  displayValue: string;
  cta: string;
  color: string;
  delay: string;
  icon: string;
}

export interface ContactProps {
  repoUrl: string;
  linkedinUrl: string;
  emailUrl: string;
}

export const iconMap: Record<string, string> = {
