---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'target' | 'rel'> & { href: string };

const { href, ...attributes } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" {...attributes}>
  <slot /><span class="sr-only" lang="es">(se abre en una pestaña nueva)</span>
</a>
