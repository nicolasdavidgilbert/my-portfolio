---
import '../styles/global.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_IMAGE, absoluteUrl, person, themeColors } from '../data/site';
import { structuredData } from '../data/seo';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(SOCIAL_IMAGE);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.fullName} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={themeColors.bg} />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={person.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Portfolio de ${person.fullName}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen overflow-x-clip">
    <a
      href="#content"
      class="sr-only rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Saltar al contenido
    </a>
    <div id="top"></div>
    <SiteHeader />
    <main id="content" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
