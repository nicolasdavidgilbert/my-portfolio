---
import '../styles/global.css';
import {
  SOCIAL_IMAGE,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_NAME,
  SITE_TITLE,
  absoluteUrl,
  personStructuredData,
  portfolioStructuredData,
  websiteStructuredData,
} from '../data/seo';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = SOCIAL_IMAGE,
  type = 'profile',
  structuredData = [websiteStructuredData, personStructuredData, portfolioStructuredData],
} = Astro.props;

const canonicalUrl = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const jsonLd = JSON.stringify(structuredData);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="description" content={description} />
    <meta name="author" content="Nicolás David Gilbert González" />
    <meta name="creator" content="Nicolás David Gilbert González" />
    <meta name="publisher" content="Nicolás David Gilbert González" />
    <meta name="keywords" content={SITE_KEYWORDS.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#070c18" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />

    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio de Nicolás David Gilbert González" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Portfolio de Nicolás David Gilbert González" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" href={canonicalUrl} hreflang="es" />
    <link rel="alternate" href={canonicalUrl} hreflang="x-default" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#60a5fa" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden font-sans text-text">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-[24rem] bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.12),transparent_60%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-[18rem] bg-[radial-gradient(circle_at_bottom,rgba(20,184,166,0.10),transparent_62%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:56px_56px] opacity-[0.12]"></div>
    </div>

    <div class="relative flex min-h-screen flex-col">
      <a
        href="#content"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:border focus:border-border focus:bg-elev focus:px-4 focus:py-2"
      >
        Saltar al contenido
      </a>

      <header class="site-header sticky top-0 z-40 border-b border-transparent backdrop-blur-xl">
        <div class="site-header-inner mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
          <a href="#top" class="group inline-flex items-center gap-3">
            <span class="site-brand-icon grid h-11 w-11 place-items-center rounded-2xl border border-white/10 bg-slate-950/80 shadow-[inset_0_0_24px_rgba(59,130,246,0.18)] transition-transform duration-300 group-hover:-translate-y-0.5">
              <img src="/favicon.svg" alt="Nico" class="h-6 w-6" />
            </span>
            <span class="site-brand-copy hidden flex-col leading-none sm:flex">
              <span class="site-brand-kicker text-[11px] uppercase tracking-[0.28em] text-muted">Portfolio</span>
              <span class="site-brand-title text-sm font-semibold text-white/90">Nicolás David</span>
            </span>
          </a>

          <nav class="site-nav hidden items-center gap-2 md:flex">
            <a class="btn text-sm" href="#about">Sobre mí</a>
            <a class="btn text-sm" href="#proyectos">Proyectos</a>
            <a class="btn text-sm" href="#skills">Skills</a>
            <a class="btn-primary text-sm" href="#contacto">Contacto</a>
          </nav>

          <details class="group relative md:hidden">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl border border-white/10 bg-slate-900/70 px-3 py-2 text-sm text-white/85 transition-all duration-300 hover:border-accent/40 hover:bg-slate-900/90">
              <span class="sr-only">Abrir navegación</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300 group-open:rotate-90" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>

            <div class="absolute right-0 top-full mt-2 w-52 rounded-2xl border border-white/10 bg-slate-950/95 p-2 shadow-2xl backdrop-blur-xl">
              <div class="flex flex-col gap-2">
                <a class="btn justify-center text-sm" href="#about">Sobre mí</a>
                <a class="btn justify-center text-sm" href="#proyectos">Proyectos</a>
                <a class="btn justify-center text-sm" href="#skills">Skills</a>
                <a class="btn-primary justify-center text-sm" href="#contacto">Contacto</a>
              </div>
            </div>
          </details>
        </div>
      </header>

      <main id="content" class="relative z-10 flex-1">
        <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
          <slot />
        </div>
      </main>

      <footer class="relative z-10 border-t border-white/5 bg-slate-950/40">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-5 text-sm text-muted sm:px-6 lg:px-8 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} Nicolás David Gilbert González</p>
          <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted/80">Astro + Tailwind CSS</p>
        </div>
      </footer>
    </div>
  </body>
</html>
