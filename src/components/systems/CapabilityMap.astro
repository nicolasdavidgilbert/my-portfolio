---
import T from '../i18n/T.astro';
import { projectKey } from '../../i18n/project-keys';
import type { Capability } from '../../types/technology';

interface Props {
  capabilities: readonly Capability[];
}

const { capabilities } = Astro.props;
---

<div>
  <T as="h3" k="systems.verify" class="label text-fg-subtle" />
  <dl class="mt-4 divide-y divide-border border-y border-border">
    {capabilities.map((capability, index) => (
      <div
        class="group grid gap-1 py-4 transition-colors hover:bg-surface/60 md:grid-cols-[12rem_1fr_auto] md:items-baseline md:gap-6 md:px-3"
        data-reveal
        style={`--reveal-delay:${index * 80}ms`}
      >
        <T as="dt" k={capability.area} class="font-medium text-fg transition-colors group-hover:text-accent" />
        <T as="dd" k={capability.practice} class="text-fg-muted" />
        <dd class="font-mono text-sm">
          <a
            href={`#${capability.evidence}`}
            class="inline-flex min-h-8 items-center text-accent underline-offset-4 hover:underline"
          >
            <span aria-hidden="true">→ </span>
            <T k={projectKey(capability.evidence, 'shortName')} />
          </a>
        </dd>
      </div>
    ))}
  </dl>
</div>
