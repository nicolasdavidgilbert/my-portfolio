---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import RepoHeader from "../components/RepoHeader.astro";
import CommitCard from "../components/CommitCard.astro";
import Tag from "../components/Tag.astro";
import CodeWindow from "../components/CodeWindow.astro";
import { commits, skills, readme } from "../data/commits";

const repoUrl = "https://github.com/nicolasdavidgilbert";

import SkillsBoard from "../components/SkillsBoard.astro";

const categories = [
	{
		title: "Frontend",
		items: [
			{ label: "HTML", icon: "/icons/html5.svg" },
			{ label: "CSS", icon: "/icons/css3.svg" },
			{ label: "JavaScript", icon: "/icons/js.svg" },
			{ label: "React", icon: "/icons/react.svg" },
			{ label: "TailwindCSS", icon: "/icons/tailwind.svg" },
		],
	},
	{
		title: "Backend",
		items: [
			{ label: "Python", icon: "/icons/python.svg" },
			{ label: "Node.js", icon: "/icons/nodejs.svg" },
			{ label: "MySQL", icon: "/icons/mysql.svg" },
			{ label: "MongoDB", icon: "/icons/mongodb.svg" },
			{ label: "Next.js", icon: "/icons/nextjs.svg" },
			{ label: "Nginx", icon: "/icons/nginx.svg" },
			{ label: "Flask", icon: "/icons/flask.svg" },
			{ label: "Docker", icon: "/icons/docker.svg" },
		],
	},
	{
		title: "Aprendiendo",
		items: [
			{ label: "Astro", icon: "/icons/astro.svg" },
			{ label: "TypeScript", icon: "/icons/typescript.svg" },
		],
	},
	{
		title: "Herramientas",
		items: [
			{ label: "Git", icon: "/icons/git.svg" },
			{ label: "GitHub", icon: "/icons/github.svg" },
			{ label: "Terminal", icon: "/icons/terminal-linux.svg" },
			{ label: "VS Code", icon: "/icons/vscode.svg" },
			{ label: "npm", icon: "/icons/npm.svg" },
		],
	},
];
---

<Layout title="Nico — Portfolio estilo Git log">
	<RepoHeader repoUrl={repoUrl} />
	{/* Log */}
	<section id="log" class="mt-7">
		<h2 class="font-mono text-[20px] text-[#cfe3ff]">
			git log — proyectos & experiencia
		</h2>
		<p class="text-muted mt-1">
			Explora los “commits”. Abre los diffs para ver detalles del proyecto
			o rol.
		</p>
		<div class="relative pl-6 mt-3">
			<div
				class="absolute left-2 top-0 bottom-0 w-[2px] bg-gradient-to-b from-[#204170] to-[#1a2a4a]"
			>
			</div>
			<div class="space-y-3">
				{
					commits.map((c) => (
						<div class="relative">
							<div class="absolute -left-[13px] top-[18px] w-2.5 h-2.5 rounded-full bg-accent" />
							<CommitCard {...c} />
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- {/* Skills */}
	<section id="skills" class="mt-8">
		<h2 class="font-mono text-[20px] text-[#cfe3ff]">git tag — skills</h2>
		<div class="flex flex-wrap gap-2 mt-2">
			{skills.map((s) => <Tag text={s} />)}
		</div>
	</section> -->
	{/* Skills Board */}
	<SkillsBoard categories={categories} />

	{/* README */}
	<section id="readme" class="mt-8">
		<h2 class="font-mono text-[20px] text-[#cfe3ff]">README.md</h2>
		<CodeWindow title="README.md">
			<pre class="m-0 p-4 text-[13px] text-[#e2e8f0]">{readme}</pre>
		</CodeWindow>
	</section>

	{/* Contacto */}
	<section id="contacto" class="mt-8 mb-10">
		<h2 class="font-mono text-[20px] text-[#cfe3ff]">
			git remote -v — contacto
		</h2>
		<div class="mt-2 grid gap-3">
			<div
				class="flex items-center justify-between gap-2 px-3 py-2 bg-[#0a142b] border border-border rounded-xl text-sm"
			>
				<span
					>origin <a href={repoUrl} target="_blank" rel="noreferrer"
						>{repoUrl}</a
					> (fetch)</span
				>
				<a class="btn" href={repoUrl} target="_blank">Abrir</a>
			</div>
			<div
				class="flex items-center justify-between gap-2 px-3 py-2 bg-[#0a142b] border border-border rounded-xl text-sm"
			>
				<span
					>origin <a
						href="https://www.linkedin.com/in/tuusuario"
						target="_blank"
						rel="noreferrer"
						>https://www.linkedin.com/in/tuusuario</a
					> (social)</span
				>
				<a
					class="btn"
					href="https://www.linkedin.com/in/tuusuario"
					target="_blank"
					rel="noreferrer">Abrir</a
				>
			</div>
			<div
				class="flex items-center justify-between gap-2 px-3 py-2 bg-[#0a142b] border border-border rounded-xl text-sm"
			>
				<span
					>origin <a href="mailto:tu.email@ejemplo.com"
						>tu.email@ejemplo.com</a
					> (email)</span
				>
			</div>
		</div>
	</section></Layout
>
