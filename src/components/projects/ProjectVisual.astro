---
import type { ProjectVisual } from '../../types/project';
import ArchitectureDiagram from '../systems/ArchitectureDiagram.astro';
import TerminalCommand from '../systems/TerminalCommand.astro';
import TerminalWindow from '../systems/TerminalWindow.astro';
import TuiVisual from './TuiVisual.astro';
import { i18nAttrs } from '../../i18n/translate';
import type { TranslationKey } from '../../i18n/types';

interface Props {
  visual: ProjectVisual;
  /** Host shown in the screenshot frame. */
  host?: string;
  /** Project name, used in accessible labels. */
  nameKey: TranslationKey;
}

const { visual, host, nameKey } = Astro.props;
---

{visual.type === 'screenshot' && (
  <figure class="overflow-hidden rounded-lg border border-border bg-surface">
    {host && (
      <figcaption class="border-b border-border px-4 py-2.5 font-mono text-xs text-fg-subtle">
        <span aria-hidden="true">https://</span>
        {host}
      </figcaption>
    )}
    <img
      src={visual.src}
      {...i18nAttrs({ alt: visual.alt })}
      width={visual.width}
      height={visual.height}
      loading="lazy"
      decoding="async"
      class="block h-auto w-full"
    />
  </figure>
)}

{visual.type === 'terminal' && (
  <TerminalWindow title={visual.title} meta="bash">
    <TerminalCommand lines={visual.lines} />
  </TerminalWindow>
)}

{visual.type === 'diagram' && <ArchitectureDiagram diagram={visual.diagram} />}

{visual.type === 'tui' && <TuiVisual visual={visual} nameKey={nameKey} />}
