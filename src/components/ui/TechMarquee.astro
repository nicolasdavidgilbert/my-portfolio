---
import type { TechnologyRow } from '../../types/technology';
import TechChip from './TechChip.astro';

interface Props {
  row: TechnologyRow;
  reverse?: boolean;
  /** Seconds per full loop. */
  duration?: number;
}

const { row, reverse = false, duration = 40 } = Astro.props;
// Repeat short rows so one track is always wider than the viewport.
const loop = [...row.items, ...row.items];
---

<div class="marquee" style={`--duration:${duration}s`} data-reverse={reverse ? '' : undefined}>
  <h3 class="label mx-auto mb-4 max-w-page px-gutter text-fg-subtle sm:px-6 lg:px-8" lang="en">{row.title}</h3>
  <div class="marquee-viewport">
    <ul class="marquee-track" aria-label={row.title}>
      {loop.map((item, index) => (
        <li aria-hidden={index >= row.items.length ? 'true' : undefined}><TechChip item={item} /></li>
      ))}
    </ul>
    <ul class="marquee-track marquee-clone" aria-hidden="true">
      {loop.map((item) => <li><TechChip item={item} /></li>)}
    </ul>
  </div>
</div>

<style>
  .marquee {
    --marquee-gap: 0.85rem;
  }

  .marquee-viewport {
    display: flex;
    gap: var(--marquee-gap);
    overflow: hidden;
    padding-block: 0.6rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    gap: var(--marquee-gap);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee var(--duration) linear infinite;
    }

    .marquee[data-reverse] .marquee-track {
      animation-direction: reverse;
    }

    .marquee-viewport:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-viewport {
      mask-image: none;
      padding-inline: var(--spacing-gutter);
    }

    .marquee-track {
      flex-wrap: wrap;
    }

    .marquee-track > li[aria-hidden] {
      display: none;
    }

    .marquee-clone {
      display: none;
    }
  }
</style>
